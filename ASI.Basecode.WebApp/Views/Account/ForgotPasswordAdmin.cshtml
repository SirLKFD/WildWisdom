@using ASI.Basecode.Services.ServiceModels
@model ForgotPasswordViewModel
@{
    ViewBag.LoginView = true;
    ViewData["Title"] = "Admin - Forgot Password - WildWisdom";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-logo">
                <img src="~/img/WildWisdom-main-logo.png" alt="WildWisdom Logo">
            </div>

            <div style="text-align: center; margin-bottom: 10px;">
                <span style="display: inline-block; background: #A66D3F; color: white; padding: 6px 16px; border-radius: 20px; font-size: 14px; font-weight: 600;">Admin - Forgot Password</span>
            </div>

            <h1 class="auth-title">Reset Password</h1>
            <p class="auth-subtitle">Enter your email address and we'll send you a reset link</p>

            <div asp-validation-summary="ModelOnly" class="text-danger" style="text-align: center; margin-bottom: 20px;"></div>

            <form method="post" action="/Account/ForgotPasswordAdmin" id="forgotPasswordForm">
                <div class="form-group">
                    <label class="form-label" for="email">Email Address</label>
                    <input type="email" 
                           id="email" 
                           asp-for="Email"
                           class="form-control"
                           placeholder="Enter your registered email address" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <button class="btn-auth" type="submit">
                    Send Reset Link
                </button>
            </form>

            <div class="auth-footer">
                <p>Remember your password?</p>
                <a asp-controller="Account" asp-action="LoginAdmin" class="btn-secondary-auth">Back to Login</a>
            </div>

            <div style="text-align: center; margin-top: 20px; padding-top: 20px; border-top: 1px solid #E5E5E5;">
                <p style="color: #666; font-size: 14px;">User forgot password? <a asp-controller="Account" asp-action="ForgotPasswordUser" class="auth-link">Click here</a></p>
            </div>
        </div>
    </div>

    <!-- Email Sent Modal -->
    <div id="emailSentModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 9999; align-items: center; justify-content: center;">
        <div style="background: white; border-radius: 24px; padding: 40px; max-width: 500px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
            <div style="text-align: center;">
                <div style="width: 80px; height: 80px; background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%); border-radius: 50%; margin: 0 auto 20px; display: flex; align-items: center; justify-content: center;">
                    <svg width="40" height="40" fill="white" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                </div>
                <h2 style="color: #2C2C2C; font-size: 24px; font-weight: 700; margin-bottom: 15px;">Check Your Email!</h2>
                <p style="color: #666; font-size: 15px; line-height: 1.6; margin-bottom: 20px;">
                    A password reset link has been sent to<br/>
                    <strong id="modalEmail" style="color: #A66D3F;"></strong>
                </p>
                <p style="color: #666; font-size: 14px; margin-bottom: 30px;">
                    Please check your inbox and follow the instructions to reset your password.
                </p>
                <p style="color: #999; font-size: 13px; margin-bottom: 25px;">
                    ⏱️ The link will expire in <strong>30 minutes</strong>
                </p>
                <button onclick="closeModal()" style="background: linear-gradient(135deg, #A66D3F 0%, #8B5A2B 100%); color: white; border: none; padding: 12px 30px; border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 16px;">
                    Got it!
                </button>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <script>
        // Check for error message and display Toastr notification
        var errorMessage = '@TempData["ErrorMessage"]';
        if (errorMessage) {
            toastr.error(errorMessage);
        }

        // Show email sent modal
        var showModal = '@TempData["ShowEmailSentModal"]';
        var resetEmail = '@TempData["ResetEmail"]';
        if (showModal) {
            document.getElementById('modalEmail').textContent = resetEmail;
            document.getElementById('emailSentModal').style.display = 'flex';
        }

        function closeModal() {
            document.getElementById('emailSentModal').style.display = 'none';
        }
    </script>
</body>
</html>
