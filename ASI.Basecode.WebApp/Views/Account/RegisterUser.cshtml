@using ASI.Basecode.Services.ServiceModels
@model UserViewModel
@{
    ViewBag.LoginView = true;
    ViewData["Title"] = "User Registration - WildWisdom";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-logo">
                <img src="~/img/WildWisdom-main-logo.png" alt="WildWisdom Logo">
            </div>

            <div style="text-align: center; margin-bottom: 10px;">
                <span style="display: inline-block; background: #A66D3F; color: white; padding: 6px 16px; border-radius: 20px; font-size: 14px; font-weight: 600;">User Registration</span>
            </div>

            <h1 class="auth-title">Create Account</h1>
            <p class="auth-subtitle">Join WildWisdom and start your reading adventure</p>

            <form method="post" action="/Account/RegisterUser">
                <div class="form-group">
                    <label class="form-label" for="userId">User ID</label>
                    <input type="text" 
                           id="userId" 
                           class="form-control"
                           asp-for="UserId" 
                           placeholder="Choose a unique user ID" />
                    <span asp-validation-for="UserId" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" for="name">Full Name</label>
                    <input type="text" 
                           id="name" 
                           class="form-control"
                           asp-for="Name" 
                           placeholder="Enter your full name" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

              

                <div class="form-group">
                    <label class="form-label" for="password">Password</label>
                    <input type="password" 
                           id="password" 
                           class="form-control"
                           asp-for="Password" 
                           placeholder="Create a strong password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" for="confirmpassword">Confirm Password</label>
                    <input type="password" 
                           id="confirmpassword" 
                           class="form-control" 
                           asp-for="ConfirmPassword" 
                           placeholder="Re-enter your password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button class="btn-auth" type="submit">
                    Create Account
                </button>
            </form>

            <div class="auth-footer">
                <p>Already have an account?</p>
                <a asp-controller="Account" asp-action="LoginUser" class="btn-secondary-auth">Sign In</a>
            </div>

            <div style="text-align: center; margin-top: 20px; padding-top: 20px; border-top: 1px solid #E5E5E5;">
                <p style="color: #666; font-size: 14px;">Register as Admin? <a asp-controller="Account" asp-action="RegisterAdmin" class="auth-link">Click here</a></p>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <script>
        // Check for error message and display Toastr notification
        var errorMessage = '@TempData["ErrorMessage"]';
        if (errorMessage) {
            toastr.error(errorMessage);
        }
    </script>
</body>
</html>

