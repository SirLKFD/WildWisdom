@{
    ViewData["Title"] = "Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/adminhome.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

@Html.Partial("_AdminHomeTab")

<div class="admin-main-content">
    <h1 class="admin-page-heading">
        <i class="fas fa-th-large"></i> Dashboard
    </h1>

    <div class="row">
        <!-- Statistics Cards Placeholder -->
        <div class="col-md-3 mb-4">
            <div class="admin-card text-center" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                <i class="fas fa-book fa-3x mb-3"></i>
                <h3>Total Books</h3>
                <h2 class="mb-0">-</h2>
                <p class="mb-0">Coming Soon</p>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="admin-card text-center" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white;">
                <i class="fas fa-users fa-3x mb-3"></i>
                <h3>Total Users</h3>
                <h2 class="mb-0">-</h2>
                <p class="mb-0">Coming Soon</p>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="admin-card text-center" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white;">
                <i class="fas fa-book-reader fa-3x mb-3"></i>
                <h3>Active Borrows</h3>
                <h2 class="mb-0">-</h2>
                <p class="mb-0">Coming Soon</p>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="admin-card text-center" style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%); color: white;">
                <i class="fas fa-clock fa-3x mb-3"></i>
                <h3>Overdue</h3>
                <h2 class="mb-0">-</h2>
                <p class="mb-0">Coming Soon</p>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Recent Activity Placeholder -->
        <div class="col-md-8 mb-4">
            <div class="admin-card">
                <h3 class="section-title"><i class="fas fa-chart-line"></i> Recent Activity</h3>
                <div class="text-center py-5">
                    <i class="fas fa-chart-bar fa-4x text-muted mb-3"></i>
                    <p class="text-muted">Activity charts and analytics will be displayed here</p>
                    <p class="text-secondary"><strong>Coming Soon</strong></p>
                </div>
            </div>
        </div>

        <!-- Quick Actions Placeholder -->
        <div class="col-md-4 mb-4">
            <div class="admin-card">
                <h3 class="section-title"><i class="fas fa-bolt"></i> Quick Actions</h3>
                <div class="list-group list-group-flush">
                    <a href="@Url.Action("AddBook", "AdminHome")" class="list-group-item list-group-item-action">
                        <i class="fas fa-plus-circle text-success"></i> Add New Book
                    </a>
                    <a href="@Url.Action("Index", "AdminHome")" class="list-group-item list-group-item-action">
                        <i class="fas fa-book text-primary"></i> Manage Books
                    </a>
                    <a href="@Url.Action("AdminSettings", "AdminHome")" class="list-group-item list-group-item-action">
                        <i class="fas fa-cog text-secondary"></i> Settings
                    </a>
                    <a href="#" class="list-group-item list-group-item-action disabled">
                        <i class="fas fa-user-plus text-info"></i> Manage Users (Coming Soon)
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Recent Books Placeholder -->
        <div class="col-md-12">
            <div class="admin-card">
                <h3 class="section-title"><i class="fas fa-book-open"></i> Recent Books</h3>
                <div class="text-center py-5">
                    <i class="fas fa-books fa-4x text-muted mb-3"></i>
                    <p class="text-muted">Recently added books will be displayed here</p>
                    <p class="text-secondary"><strong>Coming Soon</strong></p>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.bundle.min.js"></script>

<style>
    .section-title {
        font-size: 1.3rem;
        font-weight: 700;
        color: #7B4A2C;
        margin-bottom: 25px;
        padding-bottom: 15px;
        border-bottom: 2px solid #E8DFD3;
    }

    .admin-card h2 {
        font-size: 2.5rem;
        font-weight: 700;
    }

    .admin-card h3 {
        font-size: 1.1rem;
        margin-bottom: 10px;
    }

    .list-group-item {
        border: none;
        border-radius: 8px;
        margin-bottom: 8px;
        transition: all 0.3s ease;
    }

    .list-group-item:hover:not(.disabled) {
        background-color: #f8f9fa;
        transform: translateX(5px);
    }

    .list-group-item i {
        width: 20px;
        margin-right: 10px;
    }
</style>

</body>
</html>

