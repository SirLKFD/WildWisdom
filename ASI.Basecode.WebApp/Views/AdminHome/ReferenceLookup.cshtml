@using System.Text.Json
@model ASI.Basecode.Services.ServiceModels.BorrowTicketLookupViewModel
@{
    ViewData["Title"] = "Reference Lookup";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/adminhome.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/admin/reference-lookup.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/app-modal.css" asp-append-version="true" />
</head>
<body>

<partial name="_AdminHomeTab" />
<partial name="_AppModal" />

<div class="admin-main-content reference-lookup-page">
    <h1 class="admin-page-heading">
        <i class="fas fa-ticket-alt"></i> Reference Lookup
    </h1>

    <div class="reference-intro-card">
        <div>
            <h2>Verify Borrow Tickets Quickly</h2>
            <p>Enter a reference number provided by a patron to view reservation details before releasing books.</p>
        </div>
        <div class="lookup-hints">
            <span><i class="fas fa-clock"></i> Confirm claim deadlines</span>
            <span><i class="fas fa-user-check"></i> Verify the borrower</span>
            <span><i class="fas fa-shield-alt"></i> Prevent fraudulent claims</span>
        </div>
    </div>

    <div class="reference-search-card">
        <form id="referenceLookupForm" class="reference-form">
            <label for="referenceInput" class="reference-label">Reference Number</label>
            <div class="reference-input-group">
                <div class="reference-prefix">@(Model.OrganizationCode ?? "ORG")-</div>
                <input type="text"
                       id="dateInput"
                       name="datePart"
                       placeholder="YYYYMMDD"
                       maxlength="8"
                       autocomplete="off"
                       class="reference-date-input" />
                <div class="reference-separator">-</div>
                <input type="text"
                       id="numberInput"
                       name="numberPart"
                       placeholder="00123"
                       maxlength="5"
                       autocomplete="off"
                       class="reference-number-input" />
                <button type="submit" class="btn btn-primary reference-search-btn">
                    <i class="fas fa-search"></i> Search
                </button>
            </div>
            <div class="reference-help">
                <small><i class="fas fa-info-circle"></i> Enter the date (YYYYMMDD) and ticket number (last 5 digits) to search</small>
            </div>
        </form>
        <div id="lookupMessage" class="reference-message @(string.IsNullOrEmpty(Model.Message) ? "" : "show")">
            @Model.Message
        </div>
    </div>

    <div id="lookupResult" class="reference-result-card @(Model.Ticket != null ? "show" : "")">
        <div class="result-header">
            <div>
                <span class="result-label">Reference Number</span>
                <h2 class="result-reference" id="resultReference">@Model.Ticket?.ReferenceCode</h2>
            </div>
            <span class="result-status" id="resultStatus">@Model.Ticket?.StatusDisplay</span>
        </div>

        <div class="result-content">
            <div class="result-column">
                <h4>Book Details</h4>
                <p class="result-title" id="resultTitle">@Model.Ticket?.BookTitle</p>
                <p class="result-author" id="resultAuthor">@Model.Ticket?.BookAuthor</p>
            </div>
            <div class="result-column">
                <h4>Borrower</h4>
                <p class="result-user" id="resultUser">@Model.Ticket?.UserName</p>
                <p class="result-organization" id="resultOrganization">@Model.Ticket?.OrganizationName</p>
            </div>
        </div>

        <div class="result-timeline">
            <div class="timeline-item">
                <span class="timeline-label"><i class="fas fa-calendar-plus"></i> Created</span>
                <span class="timeline-value" id="timelineCreated">
                    @(Model.Ticket?.CreatedAt.ToString("MMMM d, yyyy h:mm tt"))
                </span>
            </div>
            <div class="timeline-item">
                <span class="timeline-label"><i class="fas fa-hourglass-half"></i> Claim By</span>
                <span class="timeline-value" id="timelineExpires">
                    @(Model.Ticket?.ExpiresAt.ToString("MMMM d, yyyy h:mm tt"))
                </span>
            </div>
            <div class="timeline-item" id="timelineClaimedWrapper">
                <span class="timeline-label"><i class="fas fa-handshake"></i> Claimed</span>
                <span class="timeline-value" id="timelineClaimed">@(Model.Ticket?.ClaimedAt?.ToString("MMMM d, yyyy h:mm tt"))</span>
            </div>
            <div class="timeline-item" id="timelineCheckedOutWrapper">
                <span class="timeline-label"><i class="fas fa-book-reader"></i> Checked Out</span>
                <span class="timeline-value" id="timelineCheckedOut">@(Model.Ticket?.CheckedOutAt?.ToString("MMMM d, yyyy h:mm tt"))</span>
            </div>
            <div class="timeline-item" id="timelineDueWrapper">
                <span class="timeline-label"><i class="fas fa-calendar-alt"></i> Due</span>
                <span class="timeline-value" id="timelineDue">@(Model.Ticket?.DueAt?.ToString("MMMM d, yyyy h:mm tt"))</span>
            </div>
            <div class="timeline-item" id="timelineReturnedWrapper">
                <span class="timeline-label"><i class="fas fa-undo-alt"></i> Returned</span>
                <span class="timeline-value" id="timelineReturned">@(Model.Ticket?.ReturnedAt?.ToString("MMMM d, yyyy h:mm tt"))</span>
            </div>
        </div>

        <div class="result-notes" id="resultNotesContainer">
            <h4>Notes</h4>
            <p id="resultNotes">@Model.Ticket?.Notes</p>
        </div>
    </div>

    <!-- Pending Claims Section -->
    <div class="pending-claims-section">
        <h3 class="section-heading">
            <i class="fas fa-clock"></i> Pending Claims
        </h3>
        <div id="pendingClaimsList" class="pending-claims-list">
            <!-- Pending claims will be loaded here -->
        </div>
    </div>

    <!-- Unreturned Books Section -->
    <div class="unreturned-books-section">
        <h3 class="section-heading">
            <i class="fas fa-book-open"></i> Unreturned Books
        </h3>
        <div id="unreturnedBooksList" class="unreturned-books-list">
            <!-- Unreturned books will be loaded here -->
        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/app-modal.js" asp-append-version="true"></script>
<script src="~/js/admin/reference-lookup.js" asp-append-version="true"></script>
</body>
</html>

