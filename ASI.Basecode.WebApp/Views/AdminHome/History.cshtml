@{
    ViewData["Title"] = "Return History";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/adminhome.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

@Html.Partial("_AdminHomeTab")

<div class="admin-main-content">
    <h1 class="admin-page-heading">
        <i class="fas fa-history"></i> Return History
    </h1>

    <!-- Search and Filter Section -->
    <div class="card shadow mb-4">
        <div class="card-body">
            <!-- Row 1: Search, Date Range, Status Filter, Search Button -->
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="searchInput" class="form-label">
                            <i class="fas fa-search"></i> Search
                        </label>
                        <input type="text" 
                               id="searchInput" 
                               class="form-control" 
                               placeholder="Search by book title, user name, or reference code..."
                               autocomplete="off">
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label for="startDate" class="form-label">
                            <i class="fas fa-calendar-alt"></i> Start Date
                        </label>
                        <input type="date" 
                               id="startDate" 
                               class="form-control">
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label for="endDate" class="form-label">
                            <i class="fas fa-calendar-alt"></i> End Date
                        </label>
                        <input type="date" 
                               id="endDate" 
                               class="form-control">
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label for="statusFilter" class="form-label">
                            <i class="fas fa-filter"></i> Status
                        </label>
                        <select id="statusFilter" class="form-control">
                            <option value="all">All Status</option>
                            <option value="returned">Returned</option>
                            <option value="cancelled">Cancelled</option>
                            <option value="expired">Expired</option>
                            <option value="lost">Lost</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label class="form-label">&nbsp;</label>
                        <div>
                            <button type="button" id="searchBtn" class="btn btn-primary btn-block">
                                <i class="fas fa-search"></i> Search
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Row 2: Fine Status Filter, Sort By, Clear Filters -->
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="fineStatusFilter" class="form-label">
                            <i class="fas fa-dollar-sign"></i> Fine Status
                        </label>
                        <select id="fineStatusFilter" class="form-control">
                            <option value="all">All Fine Status</option>
                            <option value="has-fine">Has Fine</option>
                            <option value="no-fine">No Fine</option>
                            <option value="fine-paid">Fine Paid</option>
                            <option value="fine-unpaid">Fine Unpaid</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="sortBy" class="form-label">
                            <i class="fas fa-sort"></i> Sort By
                        </label>
                        <select id="sortBy" class="form-control">
                            <option value="latest">Latest Date (Newest First)</option>
                            <option value="oldest">Oldest Date (Oldest First)</option>
                            <option value="highest-fine">Highest Fine</option>
                            <option value="lowest-fine">Lowest Fine</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">&nbsp;</label>
                        <div>
                            <button type="button" id="clearFiltersBtn" class="btn btn-outline-secondary">
                                <i class="fas fa-times"></i> Clear All Filters
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Results Section -->
    <div class="card shadow">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="fas fa-list"></i> Return History
            </h5>
            <div id="resultsInfo" class="text-muted">
                <!-- Results count will be displayed here -->
            </div>
        </div>
        <div class="card-body">
            <!-- Loading indicator -->
            <div id="loadingIndicator" class="text-center py-4" style="display: none;">
                <i class="fas fa-spinner fa-spin fa-2x text-primary"></i>
                <p class="mt-2">Loading return history...</p>
            </div>

            <!-- Error message -->
            <div id="errorMessage" class="alert alert-danger" style="display: none;">
                <i class="fas fa-exclamation-triangle"></i>
                <span id="errorText"></span>
            </div>

            <!-- No results message -->
            <div id="noResultsMessage" class="text-center py-5" style="display: none;">
                <i class="fas fa-history fa-4x text-muted mb-3"></i>
                <h4>No return history found</h4>
                <p class="text-muted">Try adjusting your search criteria or date range.</p>
            </div>

            <!-- Results table -->
            <div id="resultsTable" class="table-responsive" style="display: none;">
                <table class="table table-hover table-striped">
                    <thead class="thead-dark">
                        <tr>
                            <th>Reference Code</th>
                            <th>Book Details</th>
                            <th>Borrower</th>
                            <th>Borrow Date</th>
                            <th>Due Date</th>
                            <th>Return Date</th>
                            <th>Duration</th>
                            <th>Fine</th>
                            <th>Status</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody id="historyTableBody">
                        <!-- Data will be loaded here -->
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <!-- Pagination Section -->
            <div class="pagination-wrapper" id="paginationContainer" style="display: none;">
                <div class="pagination-info" id="paginationInfo">
                    <!-- Pagination info will be displayed here -->
                </div>
                <div class="pagination-controls" id="paginationControls">
                    <!-- Pagination controls will be generated here -->
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    (function() {
        let currentPage = 1;
        const pageSize = 20;
        let currentFilters = {
            searchQuery: '',
            startDate: null,
            endDate: null,
            statusFilter: 'all',
            fineStatusFilter: 'all',
            sortBy: 'latest'
        };

        // DOM elements
        const searchInput = document.getElementById('searchInput');
        const startDateInput = document.getElementById('startDate');
        const endDateInput = document.getElementById('endDate');
        const statusFilter = document.getElementById('statusFilter');
        const fineStatusFilter = document.getElementById('fineStatusFilter');
        const sortBy = document.getElementById('sortBy');
        const searchBtn = document.getElementById('searchBtn');
        const clearFiltersBtn = document.getElementById('clearFiltersBtn');
        const loadingIndicator = document.getElementById('loadingIndicator');
        const errorMessage = document.getElementById('errorMessage');
        const errorText = document.getElementById('errorText');
        const noResultsMessage = document.getElementById('noResultsMessage');
        const resultsTable = document.getElementById('resultsTable');
        const resultsInfo = document.getElementById('resultsInfo');
        const historyTableBody = document.getElementById('historyTableBody');
        const paginationContainer = document.getElementById('paginationContainer');
        const paginationInfo = document.getElementById('paginationInfo');
        const paginationControls = document.getElementById('paginationControls');

        // Event listeners
        searchBtn.addEventListener('click', function() {
            currentPage = 1;
            loadHistory();
        });

        clearFiltersBtn.addEventListener('click', function() {
            searchInput.value = '';
            startDateInput.value = '';
            endDateInput.value = '';
            statusFilter.value = 'all';
            fineStatusFilter.value = 'all';
            sortBy.value = 'latest';
            currentFilters = {
                searchQuery: '',
                startDate: null,
                endDate: null,
                statusFilter: 'all',
                fineStatusFilter: 'all',
                sortBy: 'latest'
            };
            currentPage = 1;
            loadHistory();
        });

        // Search on Enter key
        searchInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                currentPage = 1;
                loadHistory();
            }
        });

        // Load history data
        function loadHistory() {
            // Update current filters
            currentFilters.searchQuery = searchInput.value.trim();
            currentFilters.startDate = startDateInput.value || null;
            currentFilters.endDate = endDateInput.value || null;
            currentFilters.statusFilter = statusFilter.value;
            currentFilters.fineStatusFilter = fineStatusFilter.value;
            currentFilters.sortBy = sortBy.value;

            // Show loading indicator
            showLoading();

            // Build query parameters
            const params = new URLSearchParams({
                page: currentPage,
                pageSize: pageSize
            });

            if (currentFilters.searchQuery) {
                params.append('searchQuery', currentFilters.searchQuery);
            }
            if (currentFilters.startDate) {
                params.append('startDate', currentFilters.startDate);
            }
            if (currentFilters.endDate) {
                params.append('endDate', currentFilters.endDate);
            }
            if (currentFilters.statusFilter && currentFilters.statusFilter !== 'all') {
                params.append('statusFilter', currentFilters.statusFilter);
            }
            if (currentFilters.fineStatusFilter && currentFilters.fineStatusFilter !== 'all') {
                params.append('fineStatusFilter', currentFilters.fineStatusFilter);
            }
            if (currentFilters.sortBy && currentFilters.sortBy !== 'latest') {
                params.append('sortBy', currentFilters.sortBy);
            }

            // Make API call
            fetch(`@Url.Action("GetReturnHistory", "AdminHome")?${params.toString()}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        displayResults(data.data, data.pagination);
                    } else {
                        showError(data.message || 'Failed to load return history');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showError('Unable to load return history. Please try again.');
                });
        }

        function showLoading() {
            loadingIndicator.style.display = 'block';
            errorMessage.style.display = 'none';
            noResultsMessage.style.display = 'none';
            resultsTable.style.display = 'none';
            paginationContainer.style.display = 'none';
        }

        function showError(message) {
            loadingIndicator.style.display = 'none';
            errorText.textContent = message;
            errorMessage.style.display = 'block';
            noResultsMessage.style.display = 'none';
            resultsTable.style.display = 'none';
            paginationContainer.style.display = 'none';
        }

        function displayResults(data, pagination) {
            loadingIndicator.style.display = 'none';
            errorMessage.style.display = 'none';

            if (!data || data.length === 0) {
                noResultsMessage.style.display = 'block';
                resultsTable.style.display = 'none';
                paginationContainer.style.display = 'none';
                resultsInfo.textContent = '';
                return;
            }

            // Display results
            resultsTable.style.display = 'block';
            noResultsMessage.style.display = 'none';

            // Update results info
            const startRecord = (pagination.currentPage - 1) * pagination.pageSize + 1;
            const endRecord = Math.min(startRecord + data.length - 1, pagination.totalCount);
            resultsInfo.textContent = `Showing ${startRecord}-${endRecord} of ${pagination.totalCount} records`;

            // Populate table
            historyTableBody.innerHTML = '';
            data.forEach(item => {
                const row = createHistoryRow(item);
                historyTableBody.appendChild(row);
            });

            // Update pagination
            updatePagination(pagination);
        }

        function createHistoryRow(item) {
            const row = document.createElement('tr');
            
            // Calculate duration
            const durationText = item.duration > 0 ? `${item.duration} days` : 'N/A';
            
            // Format fine amount
            const fineText = item.fineAmount > 0 
                ? `<span class="text-danger"><i class="fas fa-dollar-sign"></i> ${item.fineAmount.toFixed(2)}</span>`
                : '<span class="text-success">No fine</span>';
            
            // Status badge
            const statusBadge = `<span class="badge badge-success">${item.status}</span>`;
            
            // Notes
            const notesText = item.notes ? 
                `<span class="text-truncate d-inline-block" style="max-width: 150px;" title="${item.notes}">${item.notes}</span>` : 
                '<span class="text-muted">-</span>';

            row.innerHTML = `
                <td>
                    <code class="text-primary">${item.referenceCode}</code>
                </td>
                <td>
                    <div>
                        <strong>${item.bookTitle}</strong>
                        ${item.bookAuthor ? `<br><small class="text-muted">by ${item.bookAuthor}</small>` : ''}
                    </div>
                </td>
                <td>
                    <i class="fas fa-user"></i> ${item.userName}
                </td>
                <td>
                    <i class="fas fa-calendar-plus"></i> ${item.checkedOutAt || 'N/A'}
                </td>
                <td>
                    <i class="fas fa-calendar-alt"></i> ${item.dueAt || 'N/A'}
                </td>
                <td>
                    <i class="fas fa-undo-alt"></i> ${item.returnedAt || 'N/A'}
                </td>
                <td>
                    <i class="fas fa-clock"></i> ${durationText}
                </td>
                <td>
                    ${fineText}
                </td>
                <td>
                    ${statusBadge}
                </td>
                <td>
                    ${notesText}
                </td>
            `;

            return row;
        }

        function updatePagination(pagination) {
            if (pagination.totalPages <= 1) {
                paginationContainer.style.display = 'none';
                return;
            }

            paginationContainer.style.display = 'block';
            
            // Update pagination info
            const startRecord = (pagination.currentPage - 1) * pagination.pageSize + 1;
            const endRecord = Math.min(startRecord + pagination.pageSize - 1, pagination.totalCount);
            paginationInfo.textContent = `Showing ${startRecord}-${endRecord} of ${pagination.totalCount} records (Page ${pagination.currentPage} of ${pagination.totalPages})`;

            // Generate pagination controls
            paginationControls.innerHTML = '';

            // Create page numbers container
            const pageNumbers = document.createElement('div');
            pageNumbers.className = 'page-numbers';

            // Previous button
            if (pagination.hasPrevious) {
                const prevBtn = document.createElement('a');
                prevBtn.href = '#';
                prevBtn.className = 'page-btn page-prev';
                prevBtn.textContent = 'Previous';
                prevBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    currentPage = pagination.currentPage - 1;
                    loadHistory();
                });
                pageNumbers.appendChild(prevBtn);
            }

            // Calculate page range
            const startPage = Math.max(1, pagination.currentPage - 2);
            const endPage = Math.min(pagination.totalPages, pagination.currentPage + 2);
            
            // Adjust if we're near the start or end
            let adjustedStartPage = startPage;
            let adjustedEndPage = endPage;
            if (endPage - startPage < 4) {
                if (startPage === 1) {
                    adjustedEndPage = Math.min(pagination.totalPages, startPage + 4);
                } else if (endPage === pagination.totalPages) {
                    adjustedStartPage = Math.max(1, endPage - 4);
                }
            }

            // First page and ellipsis
            if (adjustedStartPage > 1) {
                const firstBtn = document.createElement('a');
                firstBtn.href = '#';
                firstBtn.className = 'page-btn';
                firstBtn.textContent = '1';
                firstBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    currentPage = 1;
                    loadHistory();
                });
                pageNumbers.appendChild(firstBtn);
                
                if (adjustedStartPage > 2) {
                    const ellipsis = document.createElement('span');
                    ellipsis.className = 'page-ellipsis';
                    ellipsis.textContent = '...';
                    pageNumbers.appendChild(ellipsis);
                }
            }

            // Page numbers
            for (let i = adjustedStartPage; i <= adjustedEndPage; i++) {
                const pageBtn = document.createElement('a');
                pageBtn.href = '#';
                pageBtn.className = `page-btn ${i === pagination.currentPage ? 'active' : ''}`;
                pageBtn.textContent = i;
                
                if (i !== pagination.currentPage) {
                    pageBtn.addEventListener('click', function(e) {
                        e.preventDefault();
                        currentPage = i;
                        loadHistory();
                    });
                }
                
                pageNumbers.appendChild(pageBtn);
            }

            // Last page and ellipsis
            if (adjustedEndPage < pagination.totalPages) {
                if (adjustedEndPage < pagination.totalPages - 1) {
                    const ellipsis = document.createElement('span');
                    ellipsis.className = 'page-ellipsis';
                    ellipsis.textContent = '...';
                    pageNumbers.appendChild(ellipsis);
                }
                
                const lastBtn = document.createElement('a');
                lastBtn.href = '#';
                lastBtn.className = 'page-btn';
                lastBtn.textContent = pagination.totalPages;
                lastBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    currentPage = pagination.totalPages;
                    loadHistory();
                });
                pageNumbers.appendChild(lastBtn);
            }

            // Next button
            if (pagination.hasNext) {
                const nextBtn = document.createElement('a');
                nextBtn.href = '#';
                nextBtn.className = 'page-btn page-next';
                nextBtn.textContent = 'Next';
                nextBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    currentPage = pagination.currentPage + 1;
                    loadHistory();
                });
                pageNumbers.appendChild(nextBtn);
            }

            paginationControls.appendChild(pageNumbers);

            // Items per page selector
            const itemsPerPageDiv = document.createElement('div');
            itemsPerPageDiv.className = 'items-per-page';
            itemsPerPageDiv.innerHTML = `
                <select class="page-size-select" id="itemsPerPageSelect">
                    <option value="20" ${pagination.pageSize === 20 ? 'selected' : ''}>20 / page</option>
                    <option value="25" ${pagination.pageSize === 25 ? 'selected' : ''}>25 / page</option>
                    <option value="50" ${pagination.pageSize === 50 ? 'selected' : ''}>50 / page</option>
                    <option value="100" ${pagination.pageSize === 100 ? 'selected' : ''}>100 / page</option>
                </select>
            `;
            
            itemsPerPageDiv.querySelector('#itemsPerPageSelect').addEventListener('change', function() {
                pageSize = parseInt(this.value);
                currentPage = 1;
                loadHistory();
            });
            
            paginationControls.appendChild(itemsPerPageDiv);

            // Go to page
            const goToPageDiv = document.createElement('div');
            goToPageDiv.className = 'go-to-page';
            goToPageDiv.innerHTML = `
                <span class="go-to-label">Go to</span>
                <input type="number" class="page-input" min="1" max="${pagination.totalPages}" value="${pagination.currentPage}" id="gotoPageInput" />
                <span class="go-to-label">Page</span>
            `;
            
            goToPageDiv.querySelector('#gotoPageInput').addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    const page = Math.max(1, Math.min(parseInt(this.value) || 1, pagination.totalPages));
                    currentPage = page;
                    loadHistory();
                }
            });
            
            paginationControls.appendChild(goToPageDiv);
        }

        // Load initial data
        loadHistory();
    })();
</script>

<style>
    .form-label {
        font-weight: 600;
        color: #7B4A2C;
        margin-bottom: 5px;
    }

    .form-control {
        border: 2px solid #E8DFD3;
        border-radius: 8px;
        padding: 10px 15px;
        transition: all 0.3s ease;
    }

    .form-control:focus {
        border-color: #7B4A2C;
        box-shadow: 0 0 0 0.2rem rgba(123, 74, 44, 0.25);
    }

    .btn-primary {
        background-color: #7B4A2C;
        border-color: #7B4A2C;
        border-radius: 8px;
        padding: 10px 20px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-primary:hover {
        background-color: #5a3721;
        border-color: #5a3721;
        transform: translateY(-1px);
    }

    .btn-outline-secondary {
        border-radius: 8px;
        padding: 8px 16px;
        font-weight: 500;
    }

    .table th {
        background-color: #7B4A2C;
        color: white;
        border: none;
        font-weight: 600;
        padding: 15px 10px;
    }

    .table td {
        padding: 12px 10px;
        vertical-align: middle;
        border-color: #E8DFD3;
    }

    .table-hover tbody tr:hover {
        background-color: #F5F0E8;
    }

    .badge {
        font-size: 0.75rem;
        padding: 6px 12px;
        border-radius: 20px;
    }

    .badge-success {
        background-color: #28a745;
    }

    /* Standardized Pagination Styles */
    .pagination-wrapper {
        margin-top: 50px;
        padding: 30px 0;
        border-top: 2px solid #E8DFD3;
    }

    .pagination-controls {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 30px;
        flex-wrap: wrap;
    }

    .page-numbers {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .page-btn {
        min-width: 50px;
        height: 50px;
        padding: 0 15px;
        background-color: white;
        border: 2px solid #D4C4B0;
        color: #7B4A2C;
        font-weight: 500;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
    }

    .page-btn:hover {
        background-color: #D4A574;
        border-color: #D4A574;
        color: white;
        text-decoration: none;
    }

    .page-btn.active {
        background-color: #D4A574;
        border-color: #D4A574;
        color: white;
        font-weight: 600;
        text-decoration: none;
    }

    .page-next,
    .page-prev {
        background-color: transparent;
        border: none;
        color: #8B7355;
        text-decoration: none;
        padding: 0 10px;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .page-next:hover,
    .page-prev:hover {
        color: #A66D3F;
        background-color: transparent;
        border: none;
        text-decoration: none;
    }

    .page-ellipsis {
        padding: 0 8px;
        color: #8B7355;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .items-per-page {
        display: flex;
        align-items: center;
    }

    .page-size-select {
        width: 130px;
        height: 50px;
        padding: 0 15px;
        border: 2px solid #D4C4B0;
        border-radius: 8px;
        color: #7B4A2C;
        font-weight: 500;
        background-color: white;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .page-size-select:focus {
        outline: none;
        border-color: #A66D3F;
        box-shadow: 0 0 0 3px rgba(166, 109, 63, 0.1);
    }

    .go-to-page {
        display: flex;
        align-items: center;
        gap: 10px;
        white-space: nowrap;
    }

    .go-to-label {
        color: #8B7355;
        font-weight: 500;
        line-height: 1;
        display: inline-flex;
        align-items: center;
    }

    .page-input {
        width: 70px;
        height: 50px;
        padding: 0 15px;
        border: 2px solid #D4C4B0;
        border-radius: 8px;
        color: #7B4A2C;
        font-weight: 500;
        text-align: center;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .page-input:focus {
        outline: none;
        border-color: #A66D3F;
        box-shadow: 0 0 0 3px rgba(166, 109, 63, 0.1);
    }

    .pagination-info {
        text-align: center;
        color: #6c757d;
        font-size: 0.9rem;
        margin-bottom: 10px;
    }

    /* Responsive Pagination */
    @@media (max-width: 768px) {
        .pagination-controls {
            flex-direction: column;
            gap: 20px;
        }

        .page-numbers {
            flex-wrap: wrap;
            justify-content: center;
        }

        .page-btn {
            min-width: 45px;
            height: 45px;
            font-size: 14px;
        }

        .page-size-select,
        .page-input {
            height: 45px;
        }
    }

    code {
        background-color: #F5F0E8;
        color: #7B4A2C;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.9rem;
    }

    .text-truncate {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>

</body>
</html>
