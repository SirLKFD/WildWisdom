@model IEnumerable<ASI.Basecode.Services.ServiceModels.OrgBooksViewModel>
@{
    ViewData["Title"] = "Books Management";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/adminhome.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        /* Admin books filter section */
        .books-filter-section {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
            border: 1px solid #dee2e6;
        }

        .results-info {
            color: #7B4A2C;
            font-weight: 500;
            margin-bottom: 15px;
        }

        .filter-row {
            display: flex;
            gap: 15px;
            align-items: end;
            margin-bottom: 10px;
            flex-wrap: wrap;
        }

        .filter-group {
            display: flex;
            flex-direction: column;
            min-width: 150px;
        }

        .filter-label {
            font-weight: 500;
            color: #495057;
            margin-bottom: 5px;
            font-size: 0.9rem;
        }

        .filter-input, .filter-select {
            border: 2px solid #ced4da;
            border-radius: 6px;
            padding: 8px 12px;
            font-size: 0.9rem;
            transition: all 0.3s ease;
            background: white;
        }

        .filter-input:focus, .filter-select:focus {
            border-color: #007bff;
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
        }

        .btn-search-filter {
            background: #007bff;
            color: white;
            border: none;
            border-radius: 6px;
            padding: 8px 20px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 0.9rem;
        }

        .btn-search-filter:hover {
            background: #0056b3;
        }

        .btn-clear-filters {
            background: #6c757d;
            color: white;
            border: none;
            border-radius: 6px;
            padding: 8px 20px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 0.9rem;
        }

        .btn-clear-filters:hover {
            background: #545b62;
        }

        /* Pagination Styles - Standardized to match UserHome */
        .pagination-wrapper {
            margin-top: 50px;
            padding: 30px 0;
            border-top: 2px solid #E8DFD3;
        }

        .pagination-controls {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 30px;
            flex-wrap: wrap;
        }

        .page-numbers {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .page-btn {
            min-width: 50px;
            height: 50px;
            padding: 0 15px;
            background-color: white;
            border: 2px solid #D4C4B0;
            color: #7B4A2C;
            font-weight: 500;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
        }

        .page-btn:hover {
            background-color: #D4A574;
            border-color: #D4A574;
            color: white;
            text-decoration: none;
        }

        .page-btn.active {
            background-color: #D4A574;
            border-color: #D4A574;
            color: white;
            font-weight: 600;
            text-decoration: none;
        }

        .page-next,
        .page-prev {
            background-color: transparent;
            border: none;
            color: #8B7355;
            text-decoration: none;
            padding: 0 10px;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .page-next:hover,
        .page-prev:hover {
            color: #A66D3F;
            background-color: transparent;
            border: none;
            text-decoration: none;
        }

        .page-ellipsis {
            padding: 0 8px;
            color: #8B7355;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .pagination-info {
            text-align: center;
            color: #6c757d;
            font-size: 0.9rem;
            margin-bottom: 10px;
        }

        .items-per-page {
            display: flex;
            align-items: center;
        }

        .page-size-select {
            width: 130px;
            height: 50px;
            padding: 0 15px;
            border: 2px solid #D4C4B0;
            border-radius: 8px;
            color: #7B4A2C;
            font-weight: 500;
            background-color: white;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .page-size-select:focus {
            outline: none;
            border-color: #A66D3F;
            box-shadow: 0 0 0 3px rgba(166, 109, 63, 0.1);
        }

        .go-to-page {
            display: flex;
            align-items: center;
            gap: 10px;
            white-space: nowrap;
        }

        .go-to-label {
            color: #8B7355;
            font-weight: 500;
            line-height: 1;
            display: inline-flex;
            align-items: center;
        }

        .page-input {
            width: 70px;
            height: 50px;
            padding: 0 15px;
            border: 2px solid #D4C4B0;
            border-radius: 8px;
            color: #7B4A2C;
            font-weight: 500;
            text-align: center;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .page-input:focus {
            outline: none;
            border-color: #A66D3F;
            box-shadow: 0 0 0 3px rgba(166, 109, 63, 0.1);
        }

        /* Responsive Pagination */
        @@media (max-width: 768px) {
            .filter-row {
                flex-direction: column;
                align-items: stretch;
            }
            
            .filter-group {
                min-width: auto;
            }
            
            .pagination-controls {
                flex-direction: column;
                gap: 20px;
            }

            .page-numbers {
                flex-wrap: wrap;
                justify-content: center;
            }

            .page-btn {
                min-width: 40px;
                height: 40px;
                padding: 0 10px;
                font-size: 0.9rem;
            }
        }
    </style>
</head>
<body>

@Html.Partial("_AdminHomeTab")

<div class="admin-main-content">
    <h1 class="admin-page-heading">
        <i class="fas fa-book"></i> Books Management
    </h1>

    <div class="mb-3 text-right">
        <a href="@Url.Action("AddBook", "AdminHome")" class="btn btn-success btn-lg">
            <i class="fas fa-plus"></i> Add New Book
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

        <!-- Filter Section -->
    <div class="books-filter-section">
        <h5 class="mb-3"><i class="fas fa-filter"></i> Search & Filter Books</h5>
        
        <form method="get" asp-action="Index">
            <div class="filter-row">
                <div class="filter-group">
                    <label class="filter-label">Search</label>
                    <input type="text" name="search" value="@ViewBag.SearchTerm" class="filter-input" placeholder="Search by title, author, ISBN, or publisher..." />
                </div>
                <div class="filter-group">
                    <label class="filter-label">Category</label>
                    <select name="category" class="filter-select">
                        <option value="">All Categories</option>
                        @foreach (var cat in ViewBag.Categories as List<string>)
                        {
                            <option value="@cat" selected="@(ViewBag.SelectedCategory == cat)">@cat</option>
                        }
                    </select>
                </div>
                <div class="filter-group">
                    <label class="filter-label">Genre</label>
                    <select name="genre" class="filter-select">
                        <option value="">All Genres</option>
                        @foreach (var gen in ViewBag.Genres as List<string>)
                        {
                            <option value="@gen" selected="@(ViewBag.SelectedGenre == gen)">@gen</option>
                        }
                    </select>
                </div>
                <div class="filter-group">
                    <label class="filter-label">Status</label>
                    <select name="status" class="filter-select">
                        <option value="">All Status</option>
                        <option value="active" selected="@(ViewBag.SelectedStatus == "active")">Active</option>
                        <option value="inactive" selected="@(ViewBag.SelectedStatus == "inactive")">Inactive</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label class="filter-label">Availability</label>
                    <select name="availability" class="filter-select">
                        <option value="">All</option>
                        <option value="available" selected="@(ViewBag.SelectedAvailability == "available")">Available</option>
                        <option value="out-of-stock" selected="@(ViewBag.SelectedAvailability == "out-of-stock")">Out of Stock</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label class="filter-label">Sort By</label>
                    <select name="sortBy" class="filter-select">
                        <option value="title" selected="@(ViewBag.SortBy == "title")">Title A-Z</option>
                        <option value="author" selected="@(ViewBag.SortBy == "author")">Author A-Z</option>
                        <option value="date-added" selected="@(ViewBag.SortBy == "date-added")">Date Added (Newest)</option>
                        <option value="copies-available" selected="@(ViewBag.SortBy == "copies-available")">Most Available</option>
                    </select>
                </div>
            </div>
            
            <div class="filter-row">
                <div class="filter-group">
                    <button type="submit" class="btn-search-filter">
                        <i class="fas fa-search"></i> Search
                    </button>
                </div>
                <div class="filter-group">
                    <a href="@Url.Action("Index")" class="btn-clear-filters">
                        <i class="fas fa-times"></i> Clear Filters
                    </a>
                </div>
            </div>
            
            <!-- Hidden fields for pagination -->
            <input type="hidden" name="page" value="1" />
            <input type="hidden" name="pageSize" value="@ViewBag.PageSize" />
        </form>
    </div>

    <!-- Results Info -->
    <div class="results-info">
        Showing @(ViewBag.CurrentPage > 1 ? ((ViewBag.CurrentPage - 1) * ViewBag.PageSize + 1) : 1)-@(Math.Min(ViewBag.CurrentPage * ViewBag.PageSize, ViewBag.TotalBooks)) of @ViewBag.TotalBooks books (Page @ViewBag.CurrentPage of @ViewBag.TotalPages)
    </div>

    <!-- Books Table -->
    <div class="card shadow">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table-hover table-striped table">
                        <thead class="thead-dark">
                            <tr>
                                <th>Cover</th>
                                <th>Title</th>
                                <th>Author</th>
                                <th>ISBN</th>
                                <th>Publisher</th>
                                <th>Category</th>
                                <th>Genre</th>
                                <th>Copies (Total/Avail)</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var book in Model)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(book.CoverImage))
                                        {
                                            <img src="@book.CoverImage" alt="@book.Title" style="width: 50px; height: 70px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div style="width: 50px; height: 70px; background: #e9ecef; display: flex; align-items: center; justify-content: center;">
                                                <i class="fas fa-book fa-2x text-muted"></i>
                                            </div>
                                        }
                                    </td>
                                    <td>@book.Title</td>
                                    <td>@book.Author</td>
                                    <td>@book.ISBN</td>
                                    <td>@(book.Publisher ?? "-")</td>
                                    <td>@(book.Category ?? "-")</td>
                                    <td>@(book.Genre ?? "-")</td>
                                    <td>
                                        <strong>@book.CopiesTotal</strong> / 
                                        <span class="@(book.CopiesAvailable > 0 ? "text-success" : "text-danger")">
                                            @book.CopiesAvailable
                                        </span>
                                    </td>
                                    <td>
                                        @if (book.IsActive)
                                        {
                                            <span class="badge badge-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a href="@Url.Action("EditBook", "AdminHome", new { id = book.Id })" 
                                               class="btn btn-sm btn-primary" title="Edit Book">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            @if (book.IsActive)
                                            {
                                                <button type="button" class="btn btn-sm btn-secondary" 
                                                        onclick="toggleStatus(@book.Id, '@book.Title', false)" 
                                                        title="Deactivate Book">
                                                    <i class="fas fa-eye-slash"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-success" 
                                                        onclick="toggleStatus(@book.Id, '@book.Title', true)" 
                                                        title="Activate Book">
                                                    <i class="fas fa-eye"></i>
                                                </button>
                                            }
                                            <button type="button" class="btn btn-sm btn-danger" 
                                                    onclick="deleteBook(@book.Id, '@book.Title')" title="Delete Book">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="py-5 text-center">
                    <i class="fas fa-book fa-4x text-muted mb-3"></i>
                    <h4>No books found</h4>
                    <p class="text-muted">No books match your search criteria. Try adjusting your filters.</p>
                    <a href="@Url.Action("AddBook", "AdminHome")" class="btn btn-success mt-3">
                        <i class="fas fa-plus"></i> Add New Book
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Pagination Section -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="pagination-wrapper">
            <div class="pagination-info"></div>
            <div class="pagination-controls">
                <div class="page-numbers">
                    @{
                        var currentPage = (int)ViewBag.CurrentPage;
                        var totalPages = (int)ViewBag.TotalPages;
                        var searchTerm = ViewBag.SearchTerm as string ?? "";
                        var selectedCategory = ViewBag.SelectedCategory as string ?? "";
                        var selectedGenre = ViewBag.SelectedGenre as string ?? "";
                        var selectedStatus = ViewBag.SelectedStatus as string ?? "";
                        var selectedAvailability = ViewBag.SelectedAvailability as string ?? "";
                        var sortBy = ViewBag.SortBy as string ?? "title";
                        var pageSize = (int)ViewBag.PageSize;
                    }
                    
                    @if (currentPage > 1)
                    {
                        <a href="@Url.Action("Index", new { search = searchTerm, category = selectedCategory, genre = selectedGenre, status = selectedStatus, availability = selectedAvailability, sortBy = sortBy, page = currentPage - 1, pageSize = pageSize })" class="page-btn page-prev">Previous</a>
                    }
                    
                    @{
                        var startPage = Math.Max(1, currentPage - 2);
                        var endPage = Math.Min(totalPages, currentPage + 2);
                        
                        // Adjust if we're near the start or end
                        if (endPage - startPage < 4)
                        {
                            if (startPage == 1)
                            {
                                endPage = Math.Min(totalPages, startPage + 4);
                            }
                            else if (endPage == totalPages)
                            {
                                startPage = Math.Max(1, endPage - 4);
                            }
                        }
                    }
                    
                    @if (startPage > 1)
                    {
                        <a href="@Url.Action("Index", new { search = searchTerm, category = selectedCategory, genre = selectedGenre, status = selectedStatus, availability = selectedAvailability, sortBy = sortBy, page = 1, pageSize = pageSize })" class="page-btn">1</a>
                        @if (startPage > 2)
                        {
                            <span class="page-ellipsis">...</span>
                        }
                    }
                    
                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <a href="@Url.Action("Index", new { search = searchTerm, category = selectedCategory, genre = selectedGenre, status = selectedStatus, availability = selectedAvailability, sortBy = sortBy, page = i, pageSize = pageSize })" class="page-btn @(i == currentPage ? "active" : "")">@i</a>
                    }
                    
                    @if (endPage < totalPages)
                    {
                        @if (endPage < totalPages - 1)
                        {
                            <span class="page-ellipsis">...</span>
                        }
                        <a href="@Url.Action("Index", new { search = searchTerm, category = selectedCategory, genre = selectedGenre, status = selectedStatus, availability = selectedAvailability, sortBy = sortBy, page = totalPages, pageSize = pageSize })" class="page-btn">@totalPages</a>
                    }
                    
                    @if (currentPage < totalPages)
                    {
                        <a href="@Url.Action("Index", new { search = searchTerm, category = selectedCategory, genre = selectedGenre, status = selectedStatus, availability = selectedAvailability, sortBy = sortBy, page = currentPage + 1, pageSize = pageSize })" class="page-btn page-next">Next</a>
                    }
                </div>
                
                <!-- Items per page selector -->
                <div class="items-per-page">
                    <select class="page-size-select" onchange="changePageSize(this.value)">
                        <option value="25" selected="@(pageSize == 25)">25 / page</option>
                        <option value="50" selected="@(pageSize == 50)">50 / page</option>
                        <option value="100" selected="@(pageSize == 100)">100 / page</option>
                    </select>
                </div>
                
                <!-- Go to page -->
                <div class="go-to-page">
                    <span class="go-to-label">Go to</span>
                    <input type="number" class="page-input" min="1" max="@totalPages" value="@currentPage" onkeypress="goToPage(event)" />
                    <span class="go-to-label">Page</span>
                </div>
            </div>
        </div>
    }
</div>

<!-- Delete Confirmation Form -->
<form id="deleteForm" method="post" style="display: none;">
    <input type="hidden" name="id" id="deleteBookId" />
</form>

<!-- Toggle Status Form -->
<form id="toggleForm" method="post" style="display: none;">
    <input type="hidden" name="id" id="toggleBookId" />
</form>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // Pagination helper functions
    function changePageSize(newPageSize) {
        var url = new URL(window.location);
        url.searchParams.set('pageSize', newPageSize);
        url.searchParams.set('page', '1');
        window.location.href = url.toString();
    }

    function goToPage(event) {
        if (event.key === 'Enter') {
            var pageInput = event.target;
            var page = Math.max(1, Math.min(parseInt(pageInput.value) || 1, @ViewBag.TotalPages));
            var url = new URL(window.location);
            url.searchParams.set('page', page);
            window.location.href = url.toString();
        }
    }

    // Original functions for book management
    function deleteBook(id, title) {
        if (confirm('Are you sure you want to delete "' + title + '"?')) {
            document.getElementById('deleteBookId').value = id;
            document.getElementById('deleteForm').action = '@Url.Action("DeleteBook", "AdminHome")';
            document.getElementById('deleteForm').submit();
        }
    }

    function toggleStatus(id, title, willActivate) {
        var action = willActivate ? 'activate' : 'deactivate';
        var message = 'Are you sure you want to ' + action + ' "' + title + '"?\n\n';
        
        if (willActivate) {
            message += 'This will make the book visible and available for borrowing.';
        } else {
            message += 'This will hide the book and prevent it from being borrowed.';
        }
        
        if (confirm(message)) {
            document.getElementById('toggleBookId').value = id;
            document.getElementById('toggleForm').action = '@Url.Action("ToggleBookStatus", "AdminHome")';
            document.getElementById('toggleForm').submit();
        }
    }
</script>

</body>
</html>

