@model ASI.Basecode.Services.ServiceModels.BookCheckoutViewModel
@{
    ViewData["Title"] = "My Book Cart - WildWisdom";
    Layout = null;
    var organizationName = ViewBag.OrganizationName as string ?? "Your Library";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/userhome.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

@Html.Partial("_UserHomeHeader")
@Html.Partial("_AppModal")

<div class="book-checkout-page">
    <div class="userhome-content">
        <div class="container-fluid px-4 py-4">
            <div class="checkout-header">
                <div class="checkout-header-text">
                    <h2 class="userhome-section-title">
                        <i class="fa-solid fa-book-open-reader"></i> Book Cart
                    </h2>
                    <p class="userhome-section-subtitle">
                        Claim your reserved books at <strong>@organizationName</strong>
                    </p>
                </div>
                <div class="checkout-header-indicators">
                    <div class="checkout-indicator-card">
                        <span class="indicator-label">Daily Limit</span>
                        <span class="indicator-value">@Model.DailyBorrowLimit</span>
                        <p class="indicator-caption">@Model.BorrowedToday borrowed today</p>
                    </div>
                    <div class="checkout-indicator-card">
                        <span class="indicator-label">Active Tickets</span>
                        <span class="indicator-value">
                            @if (Model.MaxActiveTickets > 0)
                            {
                                <text>@Model.ActiveTicketCount/@Model.MaxActiveTickets</text>
                            }
                            else
                            {
                                <text>@Model.ActiveTicketCount</text>
                            }
                        </span>
                        <p class="indicator-caption">
                            @if (Model.MaxActiveTickets > 0)
                            {
                                <text>@Model.RemainingActiveQuota remaining from @Model.MaxActiveTickets max</text>
                            }
                            else
                            {
                                <text>Keep track of your reserved books</text>
                            }
                        </p>
                    </div>
                    <div class="checkout-indicator-card">
                        <span class="indicator-label">Claim Window</span>
                        <span class="indicator-value">
                            @if (Model.BorrowDaysDefault > 0)
                            {
                                <text>@Model.BorrowDaysDefault days</text>
                            }
                            else
                            {
                                <text>Check policy</text>
                            }
                        </span>
                        <p class="indicator-caption">Return on schedule to avoid fines</p>
                    </div>
                </div>
            </div>

            <div class="checkout-cart-section">
                <div class="checkout-list-header">
                    <div class="custom-checkbox">
                        <input type="checkbox" id="selectAllTickets" />
                        <label for="selectAllTickets">Select All</label>
                    </div>
                    <div class="checkout-header-note">
                        Only @Model.DailyBorrowLimit books can be borrowed per day.
                    </div>
                </div>

                <!-- Cart Items Section -->
                @if (Model.CartItems != null && Model.CartItems.Any())
                {
                    <div class="cart-items-section">
                        <h4 class="cart-section-title">Cart Items</h4>
                        <div class="checkout-ticket-list" id="cartItemsList">
                            @foreach (var cartItem in Model.CartItems)
                            {
                                <div class="checkout-ticket-card" data-book-id="@cartItem.BookId">
                                    <div class="checkout-ticket-select">
                                        <input type="checkbox"
                                               class="cart-item-checkbox"
                                               value="@cartItem.BookId"
                                               data-title="@cartItem.BookTitle"
                                               data-organization="@cartItem.OrganizationName" />
                                    </div>
                                    <div class="checkout-ticket-info">
                                        <div class="checkout-ticket-cover">
                                            @if (!string.IsNullOrEmpty(cartItem.BookCoverImage))
                                            {
                                                <img src="@cartItem.BookCoverImage" alt="@cartItem.BookTitle" />
                                            }
                                            else
                                            {
                                                <div class="checkout-ticket-placeholder">
                                                    <i class="fas fa-book"></i>
                                                </div>
                                            }
                                        </div>
                                        <div class="checkout-ticket-details">
                                            <h3>@cartItem.BookTitle</h3>
                                            <p class="ticket-author">by @cartItem.BookAuthor</p>
                                            <div class="ticket-meta">
                                                <span class="ticket-reference">
                                                    <i class="fas fa-shopping-cart"></i>
                                                    <span>In Cart</span>
                                                </span>
                                                <span class="ticket-expiry">
                                                    <i class="fas fa-clock"></i>
                                                    <span>Ready to borrow</span>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <button type="button"
                                            class="checkout-remove-btn"
                                            data-book-id="@cartItem.BookId"
                                            title="Remove from cart">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }


                <!-- Empty State -->
                @if (Model.CartItems == null || !Model.CartItems.Any())
                {
                    <div class="checkout-empty-state" id="emptyCheckoutState">
                        <div class="empty-icon">
                            <i class="fas fa-book-open"></i>
                        </div>
                        <h3>No books in cart</h3>
                        <p>Browse the catalog and add books to your cart.</p>
                        <a href="@Url.Action("Browse", "UserHome")" class="btn btn-primary">
                            <i class="fas fa-compass"></i> Explore Books
                        </a>
                    </div>
                }
            </div>

            <div class="checkout-footer">
                <div class="checkout-footer-note">
                    <span class="selected-count"><strong id="selectedCount">0</strong> selected</span>
                    @if (Model.BorrowDaysDefault > 0)
                    {
                        <span class="return-reminder">
                            Return borrowed copies within <strong>@Model.BorrowDaysDefault</strong> days to avoid fines.
                        </span>
                    }
                </div>
                <button type="button" class="btn btn-borrow-now" id="borrowSelectedBtn" disabled>
                    BORROW NOW
                </button>
            </div>
        </div>
    </div>
</div>

<div class="reference-modal" id="checkoutReferenceModal">
    <div class="reference-modal-card">
        <button type="button" class="reference-modal-close" id="checkoutModalClose">
            <i class="fas fa-times"></i>
        </button>
        <div class="reference-modal-illustration">
            <i class="fas fa-book-reader"></i>
        </div>
        <div class="reference-modal-body">
            <h3>Happy Reading!</h3>
            <p class="reference-modal-text">
                Claim your books at <strong id="checkoutModalOrganization">@organizationName</strong>
            </p>
            <div class="reference-list" id="checkoutModalReferenceList"></div>
            <p class="reference-modal-note">
                Show your school ID together with your reference number.
            </p>
            <button type="button" class="reference-modal-btn" id="checkoutModalActionClose">
                Close
            </button>
        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // AppModal helper functions
    function showAppModal(type, title, message, showCancel = false, onConfirm = null) {
        const modal = document.getElementById('appModal');
        const modalTitle = document.getElementById('appModalTitle');
        const modalMessage = document.getElementById('appModalMessage');
        const modalIcon = document.getElementById('appModalIcon');
        const modalOk = document.getElementById('appModalOk');
        const modalCancel = document.getElementById('appModalCancel');
        
        // Remove existing variant classes
        modal.querySelector('.modal-content').classList.remove('is-error', 'is-warning', 'is-info', 'is-success');
        
        // Configure modal based on type
        let iconClass, variantClass;
        switch (type) {
            case 'error':
                iconClass = 'fas fa-circle-exclamation';
                variantClass = 'is-error';
                break;
            case 'warning':
                iconClass = 'fas fa-triangle-exclamation';
                variantClass = 'is-warning';
                break;
            case 'info':
                iconClass = 'fas fa-circle-info';
                variantClass = 'is-info';
                break;
            case 'success':
                iconClass = 'fas fa-circle-check';
                variantClass = 'is-success';
                break;
            default:
                iconClass = 'fas fa-circle-info';
                variantClass = 'is-info';
        }
        
        // Update modal content
        modalTitle.textContent = title;
        modalMessage.innerHTML = message;
        modalIcon.className = iconClass;
        
        // Add variant class
        modal.querySelector('.modal-content').classList.add(variantClass);
        
        // Show/hide cancel button
        if (showCancel) {
            modalCancel.style.display = 'inline-block';
        } else {
            modalCancel.style.display = 'none';
        }
        
        // Set up OK button callback
        modalOk.onclick = function() {
            const bsModal = bootstrap.Modal.getInstance(modal) || new bootstrap.Modal(modal);
            bsModal.hide();
            if (onConfirm && typeof onConfirm === 'function') {
                onConfirm();
            }
        };
        
        // Set up Cancel button callback
        modalCancel.onclick = function() {
            const bsModal = bootstrap.Modal.getInstance(modal) || new bootstrap.Modal(modal);
            bsModal.hide();
        };
        
        // Show modal
        const bsModal = new bootstrap.Modal(modal);
        bsModal.show();
    }
    
    function updateCheckoutCounters() {
        fetch('@Url.Action("GetCheckoutCounters", "UserHome")')
            .then(response => response.json())
            .then(data => {
                if (data && data.success) {
                    // Update borrowed today count
                    const borrowedTodayElement = document.querySelector('.checkout-indicator-card:first-child .indicator-value');
                    const borrowedTodayCaption = document.querySelector('.checkout-indicator-card:first-child .indicator-caption');
                    if (borrowedTodayElement && borrowedTodayCaption) {
                        borrowedTodayElement.textContent = data.borrowedToday;
                        borrowedTodayCaption.textContent = `${data.borrowedToday} borrowed today`;
                    }
                    
                    // Update active ticket count
                    const activeTicketElement = document.querySelector('.checkout-indicator-card:nth-child(2) .indicator-value');
                    const activeTicketCaption = document.querySelector('.checkout-indicator-card:nth-child(2) .indicator-caption');
                    if (activeTicketElement && activeTicketCaption) {
                        if (data.maxActiveTickets > 0) {
                            activeTicketElement.textContent = `${data.activeTicketCount}/${data.maxActiveTickets}`;
                        } else {
                            activeTicketElement.textContent = data.activeTicketCount;
                        }
                        if (data.maxActiveTickets > 0) {
                            activeTicketCaption.textContent = `${data.remainingActiveQuota} remaining from ${data.maxActiveTickets} max`;
                        } else {
                            activeTicketCaption.textContent = 'Keep track of your reserved books';
                        }
                    }
                }
            })
            .catch(error => {
                console.error('Failed to update counters:', error);
            });
    }
    
    function proceedWithCancellation(ticketId, buttonElement) {
        fetch('@Url.Action("CancelBorrowTicket", "UserHome")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
            },
            body: new URLSearchParams({ ticketId: ticketId }).toString()
        })
            .then(response => response.json())
            .then(result => {
                if (result && result.success) {
                    removeTicketCard(buttonElement);
                } else if (result && result.message) {
                    showAppModal('error', 'Cancellation Failed', result.message, false);
                } else {
                    showAppModal('error', 'Error', 'Unable to cancel reservation right now.', false);
                }
            })
            .catch(() => showAppModal('error', 'Error', 'Unable to cancel reservation right now.', false));
    }
    
    function proceedWithCartRemoval(bookId, buttonElement) {
        fetch('@Url.Action("RemoveFromCart", "UserHome")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
            },
            body: new URLSearchParams({ bookId: bookId }).toString()
        })
            .then(response => response.json())
            .then(result => {
                if (result && result.success) {
                    removeTicketCard(buttonElement);
                    // Update cart badge
                    if (typeof updateCartBadge === 'function') {
                        updateCartBadge();
                    }
                } else {
                    showAppModal('error', 'Error', 'Unable to remove book from cart right now.', false);
                }
            })
            .catch(() => showAppModal('error', 'Error', 'Unable to remove book from cart right now.', false));
    }
</script>
<script>
    (function () {
        const selectAll = document.getElementById('selectAllTickets');
        const borrowButton = document.getElementById('borrowSelectedBtn');
        const selectedCount = document.getElementById('selectedCount');
        const ticketList = document.getElementById('checkoutTicketList');
        const emptyState = document.getElementById('emptyCheckoutState');
        const modal = document.getElementById('checkoutReferenceModal');
        const modalClose = document.getElementById('checkoutModalClose');
        const modalActionClose = document.getElementById('checkoutModalActionClose');
        const modalReferenceList = document.getElementById('checkoutModalReferenceList');
        const modalOrganization = document.getElementById('checkoutModalOrganization');

        function getTicketCheckboxes() {
            return document.querySelectorAll('.ticket-checkbox');
        }

        function getCartItemCheckboxes() {
            const checkboxes = document.querySelectorAll('.cart-item-checkbox');
            console.log('getCartItemCheckboxes() called - Found cart item checkboxes:', checkboxes.length);
            checkboxes.forEach((cb, index) => {
                console.log(`Cart checkbox ${index}:`, cb.checked, cb.value, 'Element:', cb);
            });
            return checkboxes;
        }

        function getAllCheckboxes() {
            const allCheckboxes = document.querySelectorAll('.ticket-checkbox, .cart-item-checkbox');
            console.log('Found all checkboxes:', allCheckboxes.length);
            allCheckboxes.forEach((cb, index) => {
                console.log(`Checkbox ${index}:`, cb.className, cb.checked, cb.value);
            });
            return allCheckboxes;
        }

        function updateSelectedState() {
            const checkboxes = getAllCheckboxes();
            const checkedBoxes = Array.from(checkboxes).filter(cb => cb.checked);

            console.log('Total checkboxes:', checkboxes.length);
            console.log('Checked checkboxes:', checkedBoxes.length);
            console.log('Select all checked:', selectAll ? selectAll.checked : 'N/A');

            selectedCount.textContent = checkedBoxes.length;
            borrowButton.disabled = checkedBoxes.length === 0;

            if (checkboxes.length === 0) {
                if (selectAll) {
                    selectAll.checked = false;
                    selectAll.disabled = true;
                }
            } else {
                if (selectAll) {
                    selectAll.disabled = false;
                    // Only update selectAll if it's not currently being changed by user
                    if (!selectAll.matches(':focus')) {
                        selectAll.checked = checkedBoxes.length === checkboxes.length;
                    }
                }
            }
        }

        function removeTicketCard(button) {
            const card = button.closest('.checkout-ticket-card');
            if (card) {
                card.remove();
            }

            if (!getTicketCheckboxes().length && emptyState) {
                emptyState.style.display = 'flex';
            }

            updateSelectedState();
        }

        function attachCheckboxListeners() {
            const checkboxes = getAllCheckboxes();
            checkboxes.forEach(cb => {
                cb.addEventListener('change', updateSelectedState);
            });
        }

        function attachRemoveListeners() {
            const removeButtons = document.querySelectorAll('.checkout-remove-btn');
            removeButtons.forEach(btn => {
                btn.addEventListener('click', function () {
                    const ticketId = this.dataset.ticketId;
                    const bookId = this.dataset.bookId;
                    
                    if (ticketId) {
                        // Handle ticket cancellation
                        const buttonElement = this;
                        showAppModal('warning', 'Cancel Reservation', 'Cancel this reservation? The book will return to the shelf for other readers.', true, function() {
                            // Proceed with cancellation
                            proceedWithCancellation(ticketId, buttonElement);
                        });
                    } else if (bookId) {
                        // Handle cart item removal
                        const buttonElement = this;
                        showAppModal('warning', 'Remove from Cart', 'Remove this book from your cart?', true, function() {
                            // Proceed with removal
                            proceedWithCartRemoval(bookId, buttonElement);
                        });
                    }
                });
            });
        }

        function openModal(selections) {
            modalReferenceList.innerHTML = '';
            selections.forEach(ticket => {
                const item = document.createElement('div');
                item.className = 'reference-list-item';
                item.innerHTML = `
                    <div class="reference-list-content">
                        <span class="reference-list-title">${ticket.title}</span>
                        <span class="reference-list-code">${ticket.reference}</span>
                    </div>
                `;
                modalReferenceList.appendChild(item);
            });

            if (selections.length > 0) {
                modalOrganization.textContent = selections[0].organization;
            }

            modal.classList.add('show');
        }

        function closeModal() {
            modal.classList.remove('show');
        }

        function createPendingTicketCard(ticket) {
            const card = document.createElement('div');
            card.className = 'checkout-ticket-card';
            card.setAttribute('data-ticket-id', ticket.id);
            
            card.innerHTML = `
                <div class="checkout-ticket-select">
                    <input type="checkbox"
                           class="ticket-checkbox"
                           value="${ticket.id}"
                           data-reference="${ticket.reference}"
                           data-title="${ticket.title}"
                           data-organization="${ticket.organization}" />
                </div>
                <div class="checkout-ticket-info">
                    <div class="checkout-ticket-cover">
                        <div class="checkout-ticket-placeholder">
                            <i class="fas fa-book"></i>
                        </div>
                    </div>
                    <div class="checkout-ticket-details">
                        <h3>${ticket.title}</h3>
                        <p class="ticket-author">by Author</p>
                        <div class="ticket-meta">
                            <span class="ticket-reference">
                                <i class="fas fa-ticket-alt"></i>
                                <span>Ref #: <strong>${ticket.reference}</strong></span>
                            </span>
                            <span class="ticket-expiry">
                                <i class="fas fa-hourglass-half"></i>
                                <span>Claim before ${new Date(Date.now() + 24 * 60 * 60 * 1000).toLocaleString()}</span>
                            </span>
                        </div>
                    </div>
                </div>
                <button type="button"
                        class="checkout-remove-btn"
                        data-ticket-id="${ticket.id}"
                        title="Cancel reservation">
                    <i class="fas fa-trash"></i>
                </button>
            `;
            
            // Reattach event listeners
            attachCheckboxListeners();
            attachRemoveListeners();
            
            return card;
        }

        function updateEmptyState() {
            const cartItems = document.querySelectorAll('.cart-item-checkbox');
            const pendingTickets = document.querySelectorAll('.ticket-checkbox');
            
            if (cartItems.length === 0 && pendingTickets.length === 0 && emptyState) {
                emptyState.style.display = 'flex';
            } else if (emptyState) {
                emptyState.style.display = 'none';
            }
        }

        function initializeEventListeners() {
            console.log('Starting event listener initialization...');
            
            // Debug: Check if elements exist
            console.log('Select all element:', selectAll);
            console.log('Borrow button element:', borrowButton);
            console.log('Selected count element:', selectedCount);
            
            // Check if cart items exist
            const cartItems = document.querySelectorAll('.cart-item-checkbox');
            console.log('Cart items found during initialization:', cartItems.length);
            
            // Attach individual checkbox listeners first
            attachCheckboxListeners();
            attachRemoveListeners();
            
            // Then attach select all listener
            if (selectAll) {
                selectAll.addEventListener('change', function () {
                    console.log('Select all changed to:', this.checked);
                    const checkboxes = getAllCheckboxes();
                    const isChecked = this.checked;
                    checkboxes.forEach(cb => {
                        cb.checked = isChecked;
                    });
                    updateSelectedState();
                });
            }
            
            // Initialize state after all listeners are attached
            updateSelectedState();
        }

        if (borrowButton) {
            borrowButton.addEventListener('click', function () {
                console.log('Borrow button clicked - Event listener 1');
                
                // Get all checkboxes first
                const allCartCheckboxes = getCartItemCheckboxes();
                const allTicketCheckboxes = getTicketCheckboxes();
                
                // Filter for checked ones
                const cartCheckboxes = Array.from(allCartCheckboxes).filter(cb => cb.checked);
                const ticketCheckboxes = Array.from(allTicketCheckboxes).filter(cb => cb.checked);
                
                console.log('Total cart checkboxes found:', allCartCheckboxes.length);
                console.log('Total ticket checkboxes found:', allTicketCheckboxes.length);
                console.log('Cart checkboxes checked:', cartCheckboxes.length);
                console.log('Ticket checkboxes checked:', ticketCheckboxes.length);
                
                // Debug: log each checked checkbox
                cartCheckboxes.forEach((cb, index) => {
                    console.log(`Checked cart checkbox ${index}:`, cb.value, cb.dataset.title);
                });
                
                // Debug: Check the exact condition
                console.log('Condition check:');
                console.log('cartCheckboxes.length:', cartCheckboxes.length);
                console.log('ticketCheckboxes.length:', ticketCheckboxes.length);
                console.log('!cartCheckboxes.length:', !cartCheckboxes.length);
                console.log('!ticketCheckboxes.length:', !ticketCheckboxes.length);
                console.log('Combined condition (!cartCheckboxes.length && !ticketCheckboxes.length):', (!cartCheckboxes.length && !ticketCheckboxes.length));
                
                if (!cartCheckboxes.length && !ticketCheckboxes.length) {
                    console.log('ALERT TRIGGERED: No books selected');
                    showAppModal('warning', 'No Selection', 'No books selected to borrow.', false);
                    return;
                }
                
                console.log('PROCEEDING: Books are selected, continuing with borrow process...');

                // Handle cart items first
                if (cartCheckboxes.length > 0) {
                    const cartBookIds = cartCheckboxes.map(cb => parseInt(cb.value));
                    
                    console.log('Sending bookIds to server:', cartBookIds);
                    
                    // Create form data with multiple bookIds parameters
                    const formData = new URLSearchParams();
                    cartBookIds.forEach(bookId => {
                        formData.append('bookIds', bookId.toString());
                    });
                    
                    console.log('Form data:', formData.toString());
                    
                    fetch('@Url.Action("ConfirmBorrow", "UserHome")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
                        },
                        body: formData.toString()
                    })
                    .then(response => response.json())
                    .then(result => {
                        if (result && result.success) {
                            // Show modal with created tickets
                            const selections = result.tickets.map(ticket => ({
                                id: ticket.ticketId,
                                reference: ticket.referenceCode,
                                title: ticket.bookTitle,
                                organization: ticket.organizationName
                            }));
                            openModal(selections);
                            
                            // Move cart items to pending tickets section
                            cartCheckboxes.forEach(cb => {
                                const card = cb.closest('.checkout-ticket-card');
                                if (card) {
                                    // Create new pending ticket card
                                    const newTicketCard = createPendingTicketCard(selections.find(t => t.title === cb.dataset.title));
                                    
                                    // Add to pending tickets section
                                    const pendingSection = document.querySelector('#checkoutTicketList');
                                    if (pendingSection) {
                                        pendingSection.appendChild(newTicketCard);
                                    }
                                    
                                    // Remove from cart section
                                    card.remove();
                                }
                            });
                            
                            // Update cart badge
                            if (typeof updateCartBadge === 'function') {
                                updateCartBadge();
                            }
                            
                            // Update empty state
                            updateEmptyState();
                            
                            // Update counters after successful borrow
                            updateCheckoutCounters();
                        } else {
                            let errorMessage = result.message || 'Failed to create borrow requests.';
                            if (result.errors && result.errors.length > 0) {
                                errorMessage += '\n\nDetails:\n' + result.errors.join('\n');
                            }
                            showAppModal('error', 'Borrow Failed', errorMessage.replace(/\n/g, '<br>'), false);
                        }
                    })
                    .catch(() => {
                        showAppModal('error', 'Error', 'Unable to process borrow request right now.', false);
                    });
                } else {
                    // Handle existing tickets (show modal)
                    const selections = ticketCheckboxes.map(cb => ({
                        id: cb.value,
                        reference: cb.dataset.reference,
                        title: cb.dataset.title,
                        organization: cb.dataset.organization
                    }));
                    openModal(selections);
                }
            });
        }

        if (modalClose) {
            modalClose.addEventListener('click', closeModal);
        }

        if (modalActionClose) {
            modalActionClose.addEventListener('click', closeModal);
        }

        modal.addEventListener('click', function (event) {
            if (event.target === modal) {
                closeModal();
            }
        });

        // Initialize all event listeners in proper order with a small delay to ensure DOM is ready
        setTimeout(() => {
            console.log('Initializing event listeners...');
            initializeEventListeners();
        }, 100);
    })();
</script>

</body>
</html>

