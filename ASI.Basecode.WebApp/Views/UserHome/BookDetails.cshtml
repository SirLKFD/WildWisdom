@model ASI.Basecode.Services.ServiceModels.OrgBooksViewModel

@{
    ViewData["Title"] = Model.Title + " - WildWisdom";
    Layout = null;
    var booksByAuthor = ViewBag.BooksByAuthor as List<ASI.Basecode.Services.ServiceModels.OrgBooksViewModel> ?? new List<ASI.Basecode.Services.ServiceModels.OrgBooksViewModel>();
    var reviews = ViewBag.Reviews as List<ASI.Basecode.Services.ServiceModels.BookReviewDisplayViewModel> ?? new List<ASI.Basecode.Services.ServiceModels.BookReviewDisplayViewModel>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/userhome.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bookdetails.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/color-thief/2.3.0/color-thief.umd.js"></script>
</head>
<body>

@Html.Partial("_UserHomeHeader")

<div class="book-details-page">
    <div class="userhome-content">
    <div class="container-fluid">
        <div class="book-details-container">
            <div class="row">
                <!-- Left Section - Book Cover -->
                <div class="col-lg-4 col-md-5">
                    <div class="book-cover-section">
                        @if (!string.IsNullOrEmpty(Model.CoverImage))
                        {
                            <img src="@Model.CoverImage" alt="@Model.Title" class="book-detail-cover" crossorigin="anonymous" />
                        }
                        else
                        {
                            <div class="book-detail-cover-placeholder">
                                <i class="fas fa-book"></i>
                            </div>
                        }
                    </div>
                </div>

                <!-- Right Section - Book Information -->
                <div class="col-lg-8 col-md-7">
                    <div class="book-info-section">
                        <h1 class="book-detail-title">@Model.Title</h1>
                        <p class="book-detail-author">by @Model.Author</p>

                        <!-- Average Rating Display Only -->
                        <div class="average-rating-display-section">
                            <div class="star-rating-display" data-rating="@(Model.AverageRating ?? 0)">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="star fas fa-star" data-value="@i"></i>
                                }
                            </div>
                            <span class="average-rating-text">
                                @if (Model.AverageRating.HasValue)
                                {
                                    @Math.Round(Model.AverageRating.Value, 1)
                                }
                                else
                                {
                                    <text>No ratings yet</text>
                                }
                            </span>
                        </div>

                        <!-- Book Metadata -->
                        <div class="book-metadata">
                            <div class="metadata-item">
                                <span class="metadata-label">Genre</span>
                                <span class="metadata-value">@Model.Genre</span>
                            </div>
                            <div class="metadata-item">
                                <span class="metadata-label">Publisher</span>
                                <span class="metadata-value">@Model.Publisher</span>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.ISBN))
                            {
                                <div class="metadata-item">
                                    <span class="metadata-label">ISBN</span>
                                    <span class="metadata-value">@Model.ISBN</span>
                                </div>
                            }
                            @if (Model.YearPublished.HasValue)
                            {
                                <div class="metadata-item">
                                    <span class="metadata-label">Release</span>
                                    <span class="metadata-value">@Model.YearPublished</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.Edition))
                            {
                                <div class="metadata-item">
                                    <span class="metadata-label">Edition</span>
                                    <span class="metadata-value">@Model.Edition</span>
                                </div>
                            }
                        </div>

                        <!-- Description -->
                        <div class="book-description">
                            <p>@(Model.Description ?? "No description available for this book.")</p>
                        </div>

                        <!-- Availability & Action -->
                        <div class="book-action-section">
                            <div class="availability-info">
                                <span class="currently-reading">@(Model.CopiesTotal - Model.CopiesAvailable) Currently reading</span>
                                <span class="copies-available">@Model.CopiesAvailable books left</span>
                            </div>
                            @if (Model.CopiesAvailable > 0)
                            {
                                <button class="btn-borrow-now">BORROW NOW</button>
                            }
                            else
                            {
                                <button class="btn-borrow-now" disabled>OUT OF STOCK</button>
                            }
                        </div>

                        <!-- Admin/Organization Contact Information -->
                        <div class="admin-contact-section">
                            <h4 class="contact-heading">Book Available At</h4>
                            <div class="admin-contact-card">
                                <div class="admin-info-wrapper">
                                    @if (!string.IsNullOrEmpty(Model.AdminProfilePicture))
                                    {
                                        <img src="@Model.AdminProfilePicture" alt="@Model.AdminName" class="admin-avatar" />
                                    }
                                    else
                                    {
                                        <div class="admin-avatar-placeholder">
                                            <i class="fas fa-user-shield"></i>
                                        </div>
                                    }
                                    <div class="admin-details">
                                        <h5 class="admin-name">@(Model.AdminName ?? "Library Admin")</h5>
                                        <p class="org-name">@(Model.OrganizationName ?? "Organization")</p>
                                        @if (!string.IsNullOrEmpty(Model.ContactNumber))
                                        {
                                            <p class="contact-item">
                                                <i class="fas fa-phone"></i>
                                                <span>@Model.ContactNumber</span>
                                            </p>
                                        }
                                        @if (!string.IsNullOrEmpty(Model.Address))
                                        {
                                            <p class="contact-item">
                                                <i class="fas fa-map-marker-alt"></i>
                                                <span>@Model.Address</span>
                                            </p>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Your Review Section (Moved to top) -->
            <div class="your-review-section">
                <h3 class="section-heading">YOUR REVIEW</h3>
                <div class="review-content">
                    <div class="review-rating">
                        <p class="review-label">Rating:</p>
                        <div class="star-rating-interactive" data-book-id="@Model.Id" data-user-rating="@(Model.UserRating ?? 0)">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="star fas fa-star" data-value="@i"></i>
                            }
                        </div>
                    </div>
                    <div class="review-text-section">
                        <p class="review-label">Review:</p>
                        <textarea id="reviewTextInput" class="review-textarea" maxlength="250" placeholder="Share your thoughts about this book... (emojis welcome!)">@Model.UserReviewText</textarea>
                        <div class="review-meta">
                            <span class="char-counter"><span id="charCount">@(Model.UserReviewText?.Length ?? 0)</span>/250</span>
                            <button type="button" class="btn-save-review" onclick="saveReview()">Save Review</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Reader Reviews Section -->
            <div class="reader-reviews-section">
                <h3 class="section-heading">READER REVIEWS</h3>
                @if (reviews.Any())
                {
                    <div class="reviews-container">
                        @foreach (var review in reviews)
                        {
                            <div class="review-card">
                                <div class="review-header">
                                    <div class="review-user-info">
                                        @if (!string.IsNullOrEmpty(review.UserProfilePicture))
                                        {
                                            <img src="@review.UserProfilePicture" alt="@review.UserName" class="review-user-avatar" />
                                        }
                                        else
                                        {
                                            <div class="review-user-avatar-placeholder">
                                                <i class="fas fa-user"></i>
                                            </div>
                                        }
                                        <div class="review-user-details">
                                            <span class="review-username">@review.UserName</span>
                                            <span class="review-date">@GetRelativeTime(review.CreatedTime)</span>
                                        </div>
                                    </div>
                                    @if (review.Rating.HasValue)
                                    {
                                        <div class="review-rating-display">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="fas fa-star @(i <= review.Rating.Value ? "filled" : "")"></i>
                                            }
                                        </div>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(review.ReviewText))
                                {
                                    <div class="review-text">
                                        <p>@review.ReviewText</p>
                                    </div>
                                }
                                <div class="review-footer">
                                    @{
                                        var currentUserId = ViewBag.CurrentUserId as int? ?? 0;
                                        var isOwnReview = review.UserId == currentUserId;
                                    }
                                    @if (isOwnReview)
                                    {
                                        <button class="btn-like-review disabled" disabled>
                                            <i class="fas fa-thumbs-up"></i>
                                            <span class="like-count">@review.LikeCount</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn-like-review @(review.HasCurrentUserLiked ? "liked" : "")" 
                                                data-review-id="@review.ReviewId"
                                                onclick="toggleLikeReview(@review.ReviewId)">
                                            <i class="fas fa-thumbs-up"></i>
                                            <span class="like-count">@review.LikeCount</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="no-reviews">
                        <i class="fas fa-book-open"></i>
                        <p>No reviews yet</p>
                        <p class="no-reviews-subtext">Be the first to share your thoughts!</p>
                    </div>
                }
            </div>

            <!-- More by Author Section -->
            @if (booksByAuthor.Any())
            {
                <div class="more-by-author-section">
                    <h3 class="section-heading">MORE BY AUTHOR</h3>
                    <div class="author-books-carousel">
                        <button class="carousel-control prev" onclick="scrollCarousel('left')">
                            <i class="fas fa-chevron-left"></i>
                        </button>
                        <div class="author-books-container" id="authorBooksContainer">
                            @foreach (var book in booksByAuthor)
                            {
                                <div class="author-book-card" onclick="window.location.href='@Url.Action("BookDetails", new { id = book.Id })'">
                                    <div class="author-book-cover">
                                        @if (!string.IsNullOrEmpty(book.CoverImage))
                                        {
                                            <img src="@book.CoverImage" alt="@book.Title" />
                                        }
                                        else
                                        {
                                            <div class="book-cover-placeholder">
                                                <i class="fas fa-book"></i>
                                            </div>
                                        }
                                    </div>
                                    <p class="author-book-title">@book.Title</p>
                                </div>
                            }
                        </div>
                        <button class="carousel-control next" onclick="scrollCarousel('right')">
                            <i class="fas fa-chevron-right"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
    </div>
</div>

@functions {
    public string GetRelativeTime(DateTime dateTime)
    {
        var timeSpan = DateTime.Now - dateTime;
        
        if (timeSpan.TotalMinutes < 1) return "Just now";
        if (timeSpan.TotalMinutes < 60) return $"{(int)timeSpan.TotalMinutes} minutes ago";
        if (timeSpan.TotalHours < 24) return $"{(int)timeSpan.TotalHours} hours ago";
        if (timeSpan.TotalDays < 7) return $"{(int)timeSpan.TotalDays} days ago";
        if (timeSpan.TotalDays < 30) return $"{(int)(timeSpan.TotalDays / 7)} weeks ago";
        if (timeSpan.TotalDays < 365) return $"{(int)(timeSpan.TotalDays / 30)} months ago";
        
        return $"{(int)(timeSpan.TotalDays / 365)} years ago";
    }
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function() {
        // Extract colors and apply gradient background
        extractAndApplyGradient();

        // Initialize average rating display
        updateStarDisplay('.star-rating-display');
        
        // Initialize user rating display
        updateStarDisplay('.star-rating-interactive');

        // Character counter
        $('#reviewTextInput').on('input', function() {
            var length = $(this).val().length;
            $('#charCount').text(length);
        });

        // Star rating click handler
        $('.star-rating-interactive .star').on('click', function() {
            var rating = $(this).data('value');
            var bookId = $(this).parent().data('book-id');
            var currentRating = $(this).parent().data('user-rating');

            // If clicking the same star, remove rating
            if (rating == currentRating) {
                rating = null;
            }

            // Update display immediately
            $('.star-rating-interactive').data('user-rating', rating || 0);
            updateStarDisplay('.star-rating-interactive');
        });

        // Star rating hover effect
        $('.star-rating-interactive .star').on('mouseenter', function() {
            var hoverValue = $(this).data('value');
            $(this).parent().find('.star').each(function() {
                if ($(this).data('value') <= hoverValue) {
                    $(this).addClass('hover');
                } else {
                    $(this).removeClass('hover');
                }
            });
        });

        $('.star-rating-interactive').on('mouseleave', function() {
            $(this).find('.star').removeClass('hover');
        });
    });

    function saveReview() {
        var bookId = $('.star-rating-interactive').data('book-id');
        var rating = $('.star-rating-interactive').data('user-rating') || null;
        var reviewText = $('#reviewTextInput').val().trim() || null;

        // Validate review text length
        if (reviewText && reviewText.length > 250) {
            showMessage('Review text must not exceed 250 characters.', 'error');
            return;
        }

        // Send AJAX request to save rating and review
        $.ajax({
            url: '@Url.Action("RateBook", "UserHome")',
            type: 'POST',
            data: { 
                bookId: bookId, 
                rating: rating,
                reviewText: reviewText
            },
            success: function(response) {
                if (response.success) {
                    // Update average rating display
                    if (response.averageRating) {
                        $('.star-rating-display').data('rating', response.averageRating);
                        updateStarDisplay('.star-rating-display');
                        $('.average-rating-text').text(Math.round(response.averageRating * 10) / 10);
                    } else {
                        $('.star-rating-display').data('rating', 0);
                        updateStarDisplay('.star-rating-display');
                        $('.average-rating-text').text('No ratings yet');
                    }

                    // Keep user's rating displayed in interactive section
                    $('.star-rating-interactive').data('user-rating', rating || 0);
                    updateStarDisplay('.star-rating-interactive');

                    // Keep review text in textarea
                    if (reviewText) {
                        $('#reviewTextInput').val(reviewText);
                        $('#charCount').text(reviewText.length);
                    }

                    // Show success message
                    showMessage(response.message, 'success');
                } else {
                    showMessage(response.message, 'error');
                }
            },
            error: function() {
                showMessage('Error saving review. Please try again.', 'error');
            }
        });
    }

    function showMessage(message, type) {
        // Remove existing message if any
        $('.review-message').remove();

        // Create message element
        var messageClass = type === 'success' ? 'review-message-success' : 'review-message-error';
        var messageHtml = '<div class="review-message ' + messageClass + '">' + message + '</div>';
        
        // Insert after the save button
        $('.btn-save-review').after(messageHtml);

        // Fade out after 3 seconds
        setTimeout(function() {
            $('.review-message').fadeOut(500, function() {
                $(this).remove();
            });
        }, 3000);
    }

    function updateStarDisplay(selector) {
        var container = $(selector);
        var rating = parseFloat(container.data('rating')) || parseFloat(container.data('user-rating')) || 0;
        
        container.find('.star').each(function() {
            var starValue = $(this).data('value');
            if (starValue <= rating) {
                $(this).addClass('filled');
            } else {
                $(this).removeClass('filled');
            }
        });
    }

    function scrollCarousel(direction) {
        var container = document.getElementById('authorBooksContainer');
        var scrollAmount = 250;
        if (direction === 'left') {
            container.scrollLeft -= scrollAmount;
        } else {
            container.scrollLeft += scrollAmount;
        }
    }

    function toggleLikeReview(reviewId) {
        $.ajax({
            url: '@Url.Action("LikeReview", "UserHome")',
            type: 'POST',
            data: { reviewId: reviewId },
            success: function(response) {
                if (response.success) {
                    var button = $('button[data-review-id="' + reviewId + '"]');
                    
                    // Update like count
                    button.find('.like-count').text(response.likeCount);
                    
                    // Toggle liked class
                    if (response.isLiked) {
                        button.addClass('liked');
                    } else {
                        button.removeClass('liked');
                    }
                } else {
                    alert(response.message);
                }
            },
            error: function() {
                alert('Error liking review. Please try again.');
            }
        });
    }

    function extractAndApplyGradient() {
        var bookCover = $('.book-detail-cover');
        
        if (bookCover.length === 0) {
            applyDefaultGradient();
            return;
        }

        var img = bookCover[0];
        
        if (img.complete && img.naturalWidth !== 0) {
            extractColors(img);
        } else {
            $(img).on('load', function() {
                extractColors(img);
            }).on('error', function() {
                applyDefaultGradient();
            });
        }
    }

    function extractColors(img) {
        try {
            const colorThief = new ColorThief();
            const palette = colorThief.getPalette(img, 5);
            
            // Create gradient with extracted colors
            const colors = palette.map((c, i) => 
                `rgba(${c[0]}, ${c[1]}, ${c[2]}, ${0.3 - i * 0.05})`
            );
            
            const gradient = `linear-gradient(135deg, 
                ${colors[0]} 0%, 
                ${colors[1]} 25%, 
                ${colors[2]} 50%, 
                ${colors[3]} 75%, 
                ${colors[4]} 100%)`;
            
            $('.book-details-page').css({
                'background': gradient,
                'background-color': '#F2E4D4'
            });
        } catch (error) {
            console.error('Error extracting colors:', error);
            applyDefaultGradient();
        }
    }

    function applyDefaultGradient() {
        $('.book-details-page').css({
            'background': 'linear-gradient(135deg, rgba(212, 194, 176, 0.3) 0%, rgba(166, 109, 63, 0.2) 100%)',
            'background-color': '#F2E4D4'
        });
    }
</script>

</body>
</html>

