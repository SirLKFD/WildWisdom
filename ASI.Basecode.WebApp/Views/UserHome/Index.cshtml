@model List<ASI.Basecode.Services.ServiceModels.OrgBooksViewModel>

@{
    ViewData["Title"] = "Home - WildWisdom";
    Layout = null;
    var searchTerm = ViewBag.SearchTerm as string ?? "";
    var selectedCategory = ViewBag.SelectedCategory as string ?? "";
    var selectedGenre = ViewBag.SelectedGenre as string ?? "";
    var selectedAvailability = ViewBag.SelectedAvailability as string ?? "";
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var pageSize = ViewBag.PageSize as int? ?? 25;
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var genres = ViewBag.Genres as List<string> ?? new List<string>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/userhome.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        /* 5 books per row for XL screens */
        @@media (min-width: 1200px) {
            .col-xl-custom-5 {
                flex: 0 0 20%;
                max-width: 20%;
            }
        }

        @@media (max-width: 1199px) {
            .col-xl-custom-5 {
                flex: 0 0 25%;
                max-width: 25%;
            }
        }
    </style>
</head>
<body>

@Html.Partial("_UserHomeHeader")

<div class="userhome-content">
    <div class="container-fluid">
        <div class="row">
            <!-- Left Sidebar - Search Filter -->
            <div class="col-lg-2 col-md-3">
                <div class="filter-sidebar">
                    <h3 class="filter-title">SEARCH FILTER</h3>
                    
                    <form method="get" asp-action="Index">
                        <div class="filter-section">
                            <label class="filter-label">Category</label>
                            <select name="category" class="form-control filter-input">
                                <option value="">All Categories</option>
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat" @@(cat == selectedCategory ? "selected" : "")>@cat</option>
                                }
                            </select>
                        </div>

                        <div class="filter-section">
                            <label class="filter-label">Genre</label>
                            <select name="genre" class="form-control filter-input">
                                <option value="">All Genres</option>
                                @foreach (var gen in genres)
                                {
                                    <option value="@gen" @@(gen == selectedGenre ? "selected" : "")>@gen</option>
                                }
                            </select>
                        </div>

                        <div class="filter-section">
                            <label class="filter-label">Availability</label>
                            <select name="availability" class="form-control filter-input">
                                <option value="">All</option>
                                <option value="available" @@(selectedAvailability == "available" ? "selected" : "")>Available</option>
                                <option value="checkedout" @@(selectedAvailability == "checkedout" ? "selected" : "")>Checked Out</option>
                            </select>
                        </div>

                        <div class="filter-section">
                            <label class="filter-label">Sort By</label>
                            <select name="sortBy" class="form-control filter-input">
                                <option value="">Default</option>
                                <option value="latest" @@(ViewBag.SortBy == "latest" ? "selected" : "")>Latest Added</option>
                                <option value="oldest" @@(ViewBag.SortBy == "oldest" ? "selected" : "")>Oldest Added</option>
                                <option value="title-az" @@(ViewBag.SortBy == "title-az" ? "selected" : "")>Title A-Z</option>
                                <option value="title-za" @@(ViewBag.SortBy == "title-za" ? "selected" : "")>Title Z-A</option>
                                <option value="most-available" @@(ViewBag.SortBy == "most-available" ? "selected" : "")>Most Available</option>
                            </select>
                        </div>

                        <input type="hidden" name="search" value="@searchTerm" />
                        <input type="hidden" name="page" value="1" />
                        <input type="hidden" name="pageSize" value="@pageSize" />

                        <button type="submit" class="btn btn-filter">
                            <i class="fas fa-filter"></i> Apply Filter
                        </button>
                    </form>
                </div>
            </div>

            <!-- Main Content - Books Grid -->
            <div class="col-lg-10 col-md-9">
                <div class="books-container">
                    @{
                        // Filter books based on all criteria
                        var filteredBooks = Model;
                        
                        if (Model != null)
                        {
                            // Apply search filter
                            if (!string.IsNullOrEmpty(searchTerm))
                            {
                                filteredBooks = filteredBooks.Where(b => 
                                    b.Title.ToLower().Contains(searchTerm.ToLower()) || 
                                    b.Author.ToLower().Contains(searchTerm.ToLower())
                                ).ToList();
                            }
                            
                            // Apply category filter
                            if (!string.IsNullOrEmpty(selectedCategory))
                            {
                                filteredBooks = filteredBooks.Where(b => 
                                    b.Category == selectedCategory
                                ).ToList();
                            }
                            
                            // Apply genre filter
                            if (!string.IsNullOrEmpty(selectedGenre))
                            {
                                filteredBooks = filteredBooks.Where(b => 
                                    b.Genre == selectedGenre
                                ).ToList();
                            }
                            
                            // Apply availability filter
                            if (!string.IsNullOrEmpty(selectedAvailability))
                            {
                                if (selectedAvailability == "available")
                                {
                                    filteredBooks = filteredBooks.Where(b => b.CopiesAvailable > 0).ToList();
                                }
                                else if (selectedAvailability == "checkedout")
                                {
                                    filteredBooks = filteredBooks.Where(b => b.CopiesAvailable == 0).ToList();
                                }
                            }
                            
                            // Apply sorting
                            var sortBy = ViewBag.SortBy as string ?? "";
                            if (!string.IsNullOrEmpty(sortBy))
                            {
                                switch (sortBy.ToLower())
                                {
                                    case "latest":
                                        filteredBooks = filteredBooks.OrderByDescending(b => b.CreatedTime).ToList();
                                        break;
                                    case "oldest":
                                        filteredBooks = filteredBooks.OrderBy(b => b.CreatedTime).ToList();
                                        break;
                                    case "title-az":
                                        filteredBooks = filteredBooks.OrderBy(b => b.Title).ToList();
                                        break;
                                    case "title-za":
                                        filteredBooks = filteredBooks.OrderByDescending(b => b.Title).ToList();
                                        break;
                                    case "most-available":
                                        filteredBooks = filteredBooks.OrderByDescending(b => b.CopiesAvailable).ToList();
                                        break;
                                    default:
                                        // Default sorting (by title A-Z)
                                        filteredBooks = filteredBooks.OrderBy(b => b.Title).ToList();
                                        break;
                                }
                            }
                            else
                            {
                                // Default sorting when no sort is specified
                                filteredBooks = filteredBooks.OrderBy(b => b.Title).ToList();
                            }
                        }
                        
                        var hasActiveFilters = !string.IsNullOrEmpty(searchTerm) || 
                                              !string.IsNullOrEmpty(selectedCategory) || 
                                              !string.IsNullOrEmpty(selectedGenre) || 
                                              !string.IsNullOrEmpty(selectedAvailability) ||
                                              !string.IsNullOrEmpty(ViewBag.SortBy as string);
                        
                        // Calculate pagination
                        var totalBooks = filteredBooks?.Count() ?? 0;
                        var totalPages = (int)Math.Ceiling(totalBooks / (double)pageSize);
                        currentPage = Math.Max(1, Math.Min(currentPage, totalPages == 0 ? 1 : totalPages));
                        
                        var paginatedBooks = filteredBooks?
                            .Skip((currentPage - 1) * pageSize)
                            .Take(pageSize)
                            .ToList() ?? new List<ASI.Basecode.Services.ServiceModels.OrgBooksViewModel>();
                        
                        var startBook = totalBooks == 0 ? 0 : (currentPage - 1) * pageSize + 1;
                        var endBook = Math.Min(currentPage * pageSize, totalBooks);
                    }

                    @if (hasActiveFilters)
                    {
                        <div class="search-result-info">
                            <p>
                                Showing filtered results (@totalBooks books found)
                                @if (!string.IsNullOrEmpty(searchTerm))
                                {
                                    <span> - Search: <strong>@searchTerm</strong></span>
                                }
                                @if (!string.IsNullOrEmpty(selectedCategory))
                                {
                                    <span> - Category: <strong>@selectedCategory</strong></span>
                                }
                                @if (!string.IsNullOrEmpty(selectedGenre))
                                {
                                    <span> - Genre: <strong>@selectedGenre</strong></span>
                                }
                                @if (!string.IsNullOrEmpty(selectedAvailability))
                                {
                                    <span> - Availability: <strong>@(selectedAvailability == "available" ? "Available" : "Checked Out")</strong></span>
                                }
                            </p>
                            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear All Filters</a>
                        </div>
                    }

                    @if (totalBooks > 0)
                    {
                        <div class="pagination-info">
                            <p>Showing <strong>@startBook - @endBook</strong> of <strong>@totalBooks</strong> books</p>
                        </div>
                    }

                    @if (paginatedBooks != null && paginatedBooks.Any())
                    {
                        <div class="row books-grid">
                            @foreach (var book in paginatedBooks)
                            {
                                <div class="col-xl-custom-5 col-lg-3 col-md-4 col-sm-6 col-6 mb-4">
                                    <div class="book-card-simple" onclick="window.location.href='@Url.Action("BookDetails", new { id = book.Id })'">
                                        <div class="book-cover-wrapper">
                                            @if (!string.IsNullOrEmpty(book.CoverImage))
                                            {
                                                <img src="@book.CoverImage" alt="@book.Title" class="book-cover-img" />
                                            }
                                            else
                                            {
                                                <div class="book-cover-placeholder">
                                                    <i class="fas fa-book"></i>
                                                </div>
                                            }
                                        </div>
                                        <h6 class="book-card-title">@book.Title</h6>
                                        @if (book.AverageRating.HasValue)
                                        {
                                            <div class="book-card-rating">
                                                <div class="star-rating-display" data-rating="@book.AverageRating">
                                                    @for (int i = 1; i <= 5; i++)
                                                    {
                                                        <i class="star fas fa-star @(i <= Math.Round(book.AverageRating.Value) ? "filled" : "")" data-value="@i"></i>
                                                    }
                                                </div>
                                                <span class="rating-count">@Math.Round(book.AverageRating.Value, 1)</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Pagination Controls -->
                        @if (totalPages > 1)
                        {
                            <div class="pagination-wrapper">
                                <div class="pagination-controls">
                                    <!-- Page Numbers -->
                                    <div class="page-numbers">
                                        @{
                                            var startPage = Math.Max(1, currentPage - 2);
                                            var endPage = Math.Min(totalPages, currentPage + 2);
                                            
                                            // Adjust if we're near the start or end
                                            if (endPage - startPage < 4)
                                            {
                                                if (startPage == 1)
                                                {
                                                    endPage = Math.Min(totalPages, startPage + 4);
                                                }
                                                else if (endPage == totalPages)
                                                {
                                                    startPage = Math.Max(1, endPage - 4);
                                                }
                                            }
                                        }

                                        @if (currentPage > 1)
                                        {
                                            <a href="?page=@(currentPage - 1)&pageSize=@pageSize&search=@searchTerm&category=@selectedCategory&genre=@selectedGenre&availability=@selectedAvailability" class="page-btn page-prev">Previous</a>
                                        }

                                        @if (startPage > 1)
                                        {
                                            <a href="?page=1&pageSize=@pageSize&search=@searchTerm&category=@selectedCategory&genre=@selectedGenre&availability=@selectedAvailability" class="page-btn">1</a>
                                            @if (startPage > 2)
                                            {
                                                <span class="page-ellipsis">...</span>
                                            }
                                        }

                                        @for (var i = startPage; i <= endPage; i++)
                                        {
                                            var pageNum = i;
                                            <a href="?page=@pageNum&pageSize=@pageSize&search=@searchTerm&category=@selectedCategory&genre=@selectedGenre&availability=@selectedAvailability" 
                                               class="page-btn @(pageNum == currentPage ? "active" : "")">@pageNum</a>
                                        }

                                        @if (endPage < totalPages)
                                        {
                                            @if (endPage < totalPages - 1)
                                            {
                                                <span class="page-ellipsis">...</span>
                                            }
                                            <a href="?page=@totalPages&pageSize=@pageSize&search=@searchTerm&category=@selectedCategory&genre=@selectedGenre&availability=@selectedAvailability" class="page-btn">@totalPages</a>
                                        }

                                        @if (currentPage < totalPages)
                                        {
                                            <a href="?page=@(currentPage + 1)&pageSize=@pageSize&search=@searchTerm&category=@selectedCategory&genre=@selectedGenre&availability=@selectedAvailability" class="page-btn page-next">Next</a>
                                        }
                                    </div>

                                    <!-- Items per Page -->
                                    <div class="items-per-page">
                                        <select class="form-control page-size-select" onchange="window.location.href='?page=1&pageSize=' + this.value + '&search=@searchTerm&category=@selectedCategory&genre=@selectedGenre&availability=@selectedAvailability'">
                                            <option value="25" @@(pageSize == 25 ? "selected" : "")>25 / page</option>
                                            <option value="50" @@(pageSize == 50 ? "selected" : "")>50 / page</option>
                                            <option value="100" @@(pageSize == 100 ? "selected" : "")>100 / page</option>
                                            <option value="200" @@(pageSize == 200 ? "selected" : "")>200 / page</option>
                                        </select>
                                    </div>

                                    <!-- Go to Page -->
                                    <div class="go-to-page">
                                        <span class="go-to-label">Go to</span>
                                        <input type="number" class="form-control page-input" min="1" max="@totalPages" value="@currentPage" id="gotoPageInput" />
                                        <span class="go-to-label">Page</span>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            @if (hasActiveFilters)
                            {
                                <i class="fas fa-search"></i>
                                <h3>No Results Found</h3>
                                <p>No books match your selected filters. Try adjusting your search criteria.</p>
                                <a asp-action="Index" class="btn btn-primary mt-3">Clear All Filters</a>
                            }
                            else
                            {
                                <i class="fas fa-book-open"></i>
                                <h3>No Books Available</h3>
                                <p>There are currently no books in the catalog. Please check back later!</p>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Go to page functionality
    document.getElementById('gotoPageInput')?.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            const page = Math.max(1, Math.min(parseInt(this.value) || 1, @totalPages));
            window.location.href = '?page=' + page + '&pageSize=@pageSize&search=@searchTerm&category=@selectedCategory&genre=@selectedGenre&availability=@selectedAvailability';
        }
    });
</script>

</body>
</html>
