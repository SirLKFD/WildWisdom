@model List<ASI.Basecode.Services.ServiceModels.OrgBooksViewModel>

@{
    ViewData["Title"] = "Book Catalog";
}

<style>
    .book-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        cursor: pointer;
        height: 100%;
        border: 1px solid #e0e0e0;
        text-decoration: none;
        color: inherit;
        display: block;
    }

    .book-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
        text-decoration: none;
        color: inherit;
    }

    .book-cover-container {
        width: 100%;
        height: 280px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8f9fa;
        overflow: hidden;
        border-bottom: 1px solid #e0e0e0;
    }

    .book-cover {
        max-width: 100%;
        max-height: 100%;
        object-fit: cover;
    }

    .book-cover-placeholder {
        font-size: 80px;
        color: #6c757d;
    }

    .book-title {
        font-weight: 600;
        font-size: 1.1rem;
        color: #2c3e50;
        margin-bottom: 0.5rem;
        height: 2.6rem;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .book-author {
        color: #7f8c8d;
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
    }

    .book-meta {
        margin-top: auto;
    }

    .availability-badge {
        font-size: 0.85rem;
        padding: 0.35rem 0.6rem;
    }

    .search-container {
        margin-bottom: 2rem;
    }

    .page-header {
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #e0e0e0;
    }

    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        color: #6c757d;
    }

    .empty-state i {
        font-size: 5rem;
        margin-bottom: 1rem;
        color: #dee2e6;
    }
</style>

<div class="container-fluid px-4 py-4">
    <div class="page-header">
        <h1 class="display-5 mb-3">
            <i class="fas fa-book-reader text-primary"></i> Book Catalog
        </h1>
        <p class="lead text-muted mb-0">Browse books from all libraries and organizations</p>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var book in Model)
            {
                <div class="col-lg-2 col-md-3 col-sm-4 col-6 mb-4">
                    <a href="#" onclick="return false;" class="book-card card">
                        <div class="book-cover-container">
                            @if (!string.IsNullOrEmpty(book.CoverImage))
                            {
                                <img src="@book.CoverImage" alt="@book.Title" class="book-cover" />
                            }
                            else
                            {
                                <i class="fas fa-book book-cover-placeholder"></i>
                            }
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h5 class="book-title" title="@book.Title">@book.Title</h5>
                            <p class="book-author mb-2">
                                <i class="fas fa-user-edit"></i> @book.Author
                            </p>
                            
                            @if (!string.IsNullOrEmpty(book.OrganizationName))
                            {
                                <p class="text-muted mb-2" style="font-size: 0.85rem;">
                                    <i class="fas fa-university"></i> @book.OrganizationName
                                </p>
                            }
                            
                            <div class="book-meta">
                                @if (!string.IsNullOrEmpty(book.Category))
                                {
                                    <span class="badge badge-info mb-2 mr-1">@book.Category</span>
                                }
                                @if (!string.IsNullOrEmpty(book.Genre))
                                {
                                    <span class="badge badge-secondary mb-2 mr-1">@book.Genre</span>
                                }
                                
                                <div class="mt-2">
                                    @if (book.CopiesAvailable > 0)
                                    {
                                        <span class="badge badge-success availability-badge">
                                            <i class="fas fa-check-circle"></i> @book.CopiesAvailable Available
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger availability-badge">
                                            <i class="fas fa-times-circle"></i> Not Available
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-book-open"></i>
            <h3>No Books Available</h3>
            <p class="text-muted">There are currently no active books in the catalog. Please check back later!</p>
        </div>
    }
</div>
